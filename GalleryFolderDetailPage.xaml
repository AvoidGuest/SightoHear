<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SightoHear.GalleryFolderDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SightoHear"
    xmlns:models="using:SightoHear.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="FolderImageGridViewItemStyle" TargetType="GridViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <Border x:Name="RootBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="12"
                                Margin="0,0,12,12"
                                Padding="8"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="Transparent"/>
                                            <Setter Target="RootBorder.BorderBrush" Value="Transparent"/>
                                            <Setter Target="CardScale.ScaleX" Value="1"/>
                                            <Setter Target="CardScale.ScaleY" Value="1"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                                            <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                                            <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                            <Setter Target="CardScale.ScaleX" Value="0.985"/>
                                            <Setter Target="CardScale.ScaleY" Value="0.985"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ImageCardTemplate" x:DataType="models:MediaItem">
                <Grid Width="{x:Bind GalleryCardWidth}" Height="{x:Bind GalleryCardHeight}" MinWidth="72"
                      Tag="{x:Bind}"
                      CornerRadius="8"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      RightTapped="ImageItem_RightTapped">
                <FontIcon Glyph="&#xE8B9;" FontSize="32"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Image x:Name="ThumbnailImage"
                       Tag="{x:Bind}"
                       Loaded="ThumbnailImage_Loaded"
                       Unloaded="ThumbnailImage_Unloaded"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"/>
                <Border x:Name="ImageInfoBar"
                        Visibility="{x:Bind GalleryInfoVisibility}"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource SystemFillColorSolidNeutralBackgroundBrush}"
                        Opacity="0.85"
                        CornerRadius="0,0,8,8"
                        Padding="8,4">
                    <StackPanel>
                        <TextBlock Text="{x:Bind FileName}" FontSize="11" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind ImageInfoText}" FontSize="10"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   MaxLines="1" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,24,24,0" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部区域：文件夹信息 -->
        <Grid Grid.Row="0" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Width="176" Height="176"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
                <Grid>
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" FontSize="42"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              Glyph="&#xE8B7;" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Top" Spacing="6">
                    <TextBlock x:Name="FolderNameText" FontSize="34" FontWeight="SemiBold"
                               MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="FolderPathText"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="FolderStatText"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button x:Name="ViewAllButton" Grid.Row="1"
                        Width="132" Height="38" Padding="20,0" Margin="-3,-1,0,0"
                        Click="ViewAllButton_Click" CornerRadius="19">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="12" Glyph="&#xE890;" />
                        <TextBlock Text="查看全部" />
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel Grid.Column="2" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="8">
                <AutoSuggestBox x:Name="ImageSearchBox" Width="320" MinWidth="260"
                                PlaceholderText="搜索图片" QueryIcon="Find"
                                TextChanged="ImageSearchBox_TextChanged" />
            </StackPanel>
        </Grid>

        <!-- 底部区域：图片网格 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <GridView x:Name="ImageGrid" Grid.Row="0"
                      Padding="0,0,0,116"
                      IsItemClickEnabled="True"
                      ItemClick="ImageGrid_ItemClick"
                      ItemTemplate="{StaticResource ImageCardTemplate}"
                      ItemContainerStyle="{StaticResource FolderImageGridViewItemStyle}"
                      SelectionMode="None">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>

            <TextBlock x:Name="EmptyStateText" Grid.Row="0"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
