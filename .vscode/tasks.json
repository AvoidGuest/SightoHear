{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-winui3-x64-debug",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/src/SightoHear.csproj",
                "--configuration",
                "Debug",
                "--runtime",
                "win-x64",
                "-p:Platform=x64",
                "-p:SelfContained=false"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "clear": true
            },
            "problemMatcher": "$msCompile"
        },
