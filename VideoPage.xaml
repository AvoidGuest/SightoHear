<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SightoHear.VideoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SightoHear"
    xmlns:models="using:SightoHear.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled"
    Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="VideoCardPointerOverBackgroundBrush" Color="#14000000"/>
                    <SolidColorBrush x:Key="VideoCardPressedBackgroundBrush" Color="#24000000"/>
                    <SolidColorBrush x:Key="VideoCardPointerOverBorderBrush" Color="#26000000"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="VideoCardPointerOverBackgroundBrush" Color="#24FFFFFF"/>
                    <SolidColorBrush x:Key="VideoCardPressedBackgroundBrush" Color="#36FFFFFF"/>
                    <SolidColorBrush x:Key="VideoCardPointerOverBorderBrush" Color="#30FFFFFF"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <local:FilePathToImageConverter x:Key="VideoCoverConverter" />

            <Style x:Key="VideoListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <!-- CollectionViewSource：支持分组 -->
            <CollectionViewSource x:Name="GroupedCVS" IsSourceGrouped="True" ItemsPath="Items" />

            <!-- 视频卡片模板 -->
            <DataTemplate x:Key="VideoCardTemplate" x:DataType="models:MediaItem">
                <StackPanel Width="{x:Bind local:VideoPage.VideoCardWidth}" Height="{x:Bind local:VideoPage.VideoCardHeight}" Background="Transparent">
                    <Border Width="{x:Bind local:VideoPage.VideoCardWidth}" Height="{x:Bind local:VideoPage.VideoThumbHeight}" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid>
                            <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE8B2;" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Image x:Name="ThumbnailImage" Stretch="UniformToFill" Width="{x:Bind local:VideoPage.VideoCardWidth}" Height="{x:Bind local:VideoPage.VideoThumbHeight}" Opacity="0" />
                            <CheckBox x:Name="ItemCheckBox" MinWidth="0"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,4,4,0"
                                Visibility="Collapsed"
                                Checked="VideoItemCheckBox_Checked"
                                Unchecked="VideoItemCheckBox_Unchecked" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{x:Bind FileName}" FontSize="13" Height="20" MaxLines="1" TextTrimming="CharacterEllipsis" Width="{x:Bind local:VideoPage.VideoCardWidth}" Margin="0,8,0,0" />
                </StackPanel>
            </DataTemplate>

            <!-- 文件夹列表项模板 -->
            <DataTemplate x:Key="VideoFolderListItemTemplate" x:DataType="models:VideoFolderGroup">
                <Border
                    Height="64"
                    Padding="12,8"
                    Tag="{x:Bind}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    DoubleTapped="FolderItem_DoubleTapped"
                    RightTapped="FolderItem_RightTapped">
                    <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>

                        <Border
                            Width="40" Height="40"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="4">
                            <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE8B7;" FontSize="18"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind FolderPath}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind VideoCountText}"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <CheckBox x:Name="ItemCheckBox" Grid.Column="3"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Checked="VideoFolderItemCheckBox_Checked"
                            Unchecked="VideoFolderItemCheckBox_Unchecked" />
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- 文件夹网格项模板 -->
            <DataTemplate x:Key="VideoFolderGridItemTemplate" x:DataType="models:VideoFolderGroup">
                <StackPanel Width="{x:Bind local:VideoPage.VideoCardWidth}" Height="{x:Bind local:VideoPage.VideoCardHeight}" Background="Transparent"
                            DoubleTapped="FolderItem_DoubleTapped" RightTapped="FolderItem_RightTapped"
                            Tag="{x:Bind}">
                    <Border Width="{x:Bind local:VideoPage.VideoCardWidth}" Height="{x:Bind local:VideoPage.VideoThumbHeight}" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid>
                            <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE8B7;" FontSize="40"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{x:Bind DisplayName}" FontSize="13" Height="20"
                               MaxLines="1" TextTrimming="CharacterEllipsis"
                               Width="{x:Bind local:VideoPage.VideoCardWidth}" Margin="0,8,0,0" />
                    <CheckBox x:Name="ItemCheckBox" MinWidth="0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-116,4,0"
                        Visibility="Collapsed"
                        Checked="VideoFolderItemCheckBox_Checked"
                        Unchecked="VideoFolderItemCheckBox_Unchecked" />
                </StackPanel>
            </DataTemplate>

            <!-- 收藏夹列表项模板 -->
            <DataTemplate x:Key="VideoFavoriteListItemTemplate" x:DataType="models:Playlist">
                <Border
                    Height="64"
                    Padding="12,8"
                    Tag="{x:Bind}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    DoubleTapped="FavoriteItem_DoubleTapped"
                    RightTapped="FavoriteItem_RightTapped">
                    <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>

                        <Border
                            Width="40" Height="40"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="4">
                            <Grid>
                                <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE728;"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Image Source="{x:Bind CoverDisplayPath, Converter={StaticResource VideoCoverConverter}}"
                                       Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind SongCountText}"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <CheckBox x:Name="ItemCheckBox" Grid.Column="3"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Checked="VideoFavoritesItemCheckBox_Checked"
                            Unchecked="VideoFavoritesItemCheckBox_Unchecked" />
                    </Grid>
                </Border>
            </DataTemplate>
            <!-- 收藏夹网格项模板 -->
            <DataTemplate x:Key="VideoFavoriteGridItemTemplate" x:DataType="models:Playlist">
                <StackPanel Width="{x:Bind local:VideoPage.VideoCardWidth}" Height="{x:Bind local:VideoPage.VideoCardHeight}" Background="Transparent"
                            DoubleTapped="FavoriteItem_DoubleTapped" RightTapped="FavoriteItem_RightTapped"
                            Tag="{x:Bind}">
                    <Border Width="{x:Bind local:VideoPage.VideoCardWidth}" Height="{x:Bind local:VideoPage.VideoThumbHeight}" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid>
                            <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE728;" FontSize="40"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Image Source="{x:Bind CoverDisplayPath, Converter={StaticResource VideoCoverConverter}}"
                                   Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{x:Bind Name}" FontSize="13" Height="20"
                               MaxLines="1" TextTrimming="CharacterEllipsis"
                               Width="{x:Bind local:VideoPage.VideoCardWidth}" Margin="0,8,0,0" />
                    <CheckBox x:Name="ItemCheckBox" MinWidth="0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-116,4,0"
                        Visibility="Collapsed"
                        Checked="VideoFavoritesItemCheckBox_Checked"
                        Unchecked="VideoFavoritesItemCheckBox_Unchecked" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="28,24,28,0" VerticalAlignment="Center">
            <TextBlock Text="视频" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="LibraryManageButton" Content="媒体库管理" Click="LibraryManageButton_Click"
                        Height="32" Padding="12,0"/>
                <Button x:Name="EnterPlayerButton" Content="进入播放器" Click="EnterPlayerButton_Click"
                        Height="32" Padding="16,0"/>
            </StackPanel>
        </Grid>

        <!-- Tab Bar -->
        <Border Grid.Row="1" x:Name="TabBarHost" Margin="24,10,0,0"
                HorizontalAlignment="Left"
                Height="32"
                CornerRadius="4"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <local:TabCursorGrid x:Name="TabSelectorGrid" Background="Transparent">
                <Border x:Name="HoverOverlay0" CornerRadius="3" Width="52"
                        HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        Margin="4,4,0,4" IsHitTestVisible="False"
                        Background="Transparent" />
                <Border x:Name="HoverOverlay1" CornerRadius="3" Width="52"
                        HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        Margin="64,4,0,4" IsHitTestVisible="False"
                        Background="Transparent" />
                <Border x:Name="HoverOverlay2" CornerRadius="3" Width="52"
                        HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        Margin="124,4,0,4" IsHitTestVisible="False"
                        Background="Transparent" />

                <Border x:Name="TabIndicator" Width="60" CornerRadius="3"
                        HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        IsHitTestVisible="False"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="IndicatorTransform" />
                    </Border.RenderTransform>
                </Border>

                <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                    <Border Width="60" Background="Transparent">
                        <Button MinWidth="0" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                UseSystemFocusVisuals="False">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                            </Button.Resources>
                            <TextBlock x:Name="TabText0" Text="全部" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Border>
                    <Border Width="60" Background="Transparent">
                        <Button MinWidth="0" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                UseSystemFocusVisuals="False">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                            </Button.Resources>
                            <TextBlock x:Name="TabText1" Text="文件夹" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Border>
                    <Border Width="60" Background="Transparent">
                        <Button MinWidth="0" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                UseSystemFocusVisuals="False">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                            </Button.Resources>
                            <TextBlock x:Name="TabText2" Text="收藏夹" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Border>
                </StackPanel>
            </local:TabCursorGrid>
        </Border>

        <!-- ========== 全部标签工具栏 ========== -->
        <Grid x:Name="ToolbarGrid" Grid.Row="2" Margin="24,12,24,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox x:Name="SearchBox" Grid.Column="0"
                            MinWidth="300" PlaceholderText="搜索视频" QueryIcon="Find"
                            TextChanged="SearchBox_TextChanged" />

            <TextBlock x:Name="ScanStatusText" Grid.Column="2" Margin="0,0,8,0"
                       VerticalAlignment="Center" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <ToggleButton x:Name="MultiSelectToggleButton" Grid.Column="3" Height="32"
                    Margin="0,0,8,0" Padding="8,0"
                    Click="MultiSelectToggleButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" FontSize="12" Glyph="&#xEA98;" />
                    <TextBlock Text="多选" />
                </StackPanel>
            </ToggleButton>

            <Button x:Name="RefreshButton" Grid.Column="4" Height="32"
                    Margin="0,0,8,0" Padding="8,0" Click="RefreshButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" FontSize="12" Glyph="&#xE72C;" />
                    <TextBlock Text="刷新" />
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="ViewModeComboBox" Height="32"
                          SelectedIndex="0" SelectionChanged="ViewModeComboBox_SelectionChanged">
                    <ComboBoxItem Content="日期分开" />
                    <ComboBoxItem Content="连续平铺" />
                </ComboBox>
                <ComboBox x:Name="SortComboBox" Height="32"
                          SelectedIndex="1" SelectionChanged="SortComboBox_SelectionChanged">
                    <ComboBoxItem Content="A-Z" />
                    <ComboBoxItem Content="日期" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- ========== 文件夹标签工具栏 ========== -->
        <Grid x:Name="FolderToolbarGrid" Grid.Row="2" Margin="24,12,24,5" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox x:Name="FolderSearchBox" Grid.Column="0"
                            MinWidth="300" PlaceholderText="搜索文件夹" QueryIcon="Find"
                            TextChanged="FolderSearchBox_TextChanged" />

            <Button x:Name="FolderRefreshButton" Grid.Column="2" Height="32"
                    Margin="0,0,8,0" Padding="8,0" Click="FolderRefreshButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon FontSize="12" Glyph="&#xE72C;" />
                    <TextBlock Text="刷新" />
                </StackPanel>
            </Button>

            <ToggleButton x:Name="FolderMultiSelectToggleButton" Grid.Column="3" Height="32"
                    Margin="0,0,8,0" Padding="8,0"
                    Click="FolderMultiSelectToggleButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" FontSize="12" Glyph="&#xEA98;" />
                    <TextBlock Text="多选" />
                </StackPanel>
            </ToggleButton>

            <ComboBox x:Name="FolderViewModeComboBox" Grid.Column="4" Height="32"
                      Margin="0,0,8,0" SelectedIndex="1"
                      SelectionChanged="FolderViewModeComboBox_SelectionChanged">
                <ComboBoxItem Content="列表" />
                <ComboBoxItem Content="网格" />
            </ComboBox>
            <ComboBox x:Name="FolderSortComboBox" Grid.Column="5" Height="32"
                      SelectedIndex="0" SelectionChanged="FolderSortComboBox_SelectionChanged">
                <ComboBoxItem Content="名称" />
                <ComboBoxItem Content="视频数" />
            </ComboBox>
        </Grid>

        <!-- ========== 收藏标签工具栏 ========== -->
        <Grid x:Name="FavoritesToolbarGrid" Grid.Row="2" Margin="24,12,24,5" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox x:Name="FavoritesSearchBox" Grid.Column="0"
                            MinWidth="300" PlaceholderText="搜索收藏夹" QueryIcon="Find"
                            TextChanged="FavoritesSearchBox_TextChanged" />

            <Button x:Name="FavoritesRefreshButton" Grid.Column="2" Height="32"
                    Margin="0,0,8,0" Padding="8,0" Click="FavoritesRefreshButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" FontSize="12" Glyph="&#xE72C;" />
                    <TextBlock Text="刷新" />
                </StackPanel>
            </Button>

            <Button x:Name="CreateFavoriteButton" Grid.Column="3" Height="32"
                    Margin="0,0,8,0" Padding="8,0" Click="CreateFavoriteButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" FontSize="12" Glyph="&#xE710;" />
                    <TextBlock Text="新建收藏夹" />
                </StackPanel>
            </Button>

            <ToggleButton x:Name="FavoritesMultiSelectToggleButton" Grid.Column="4" Height="32"
                    Margin="0,0,8,0" Padding="8,0"
                    Click="FavoritesMultiSelectToggleButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" FontSize="12" Glyph="&#xEA98;" />
                    <TextBlock Text="多选" />
                </StackPanel>
            </ToggleButton>

            <ComboBox x:Name="FavoritesViewModeComboBox" Grid.Column="5" Height="32"
                      Margin="0,0,8,0" SelectedIndex="1"
                      SelectionChanged="FavoritesViewModeComboBox_SelectionChanged">
                <ComboBoxItem Content="列表" />
                <ComboBoxItem Content="网格" />
            </ComboBox>
            <ComboBox x:Name="FavoritesSortComboBox" Grid.Column="6" Height="32"
                      SelectedIndex="0" SelectionChanged="FavoritesSortComboBox_SelectionChanged">
                <ComboBoxItem Content="名称" />
                <ComboBoxItem Content="创建时间" />
            </ComboBox>
        </Grid>

        <!-- ========== 多选工具栏 ========== -->
        <Grid x:Name="MultiSelectToolbarGrid" Grid.Row="2" Margin="24,12,24,5" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox x:Name="SelectAllCheckBox" Grid.Column="0"
                Margin="0,0,12,0" VerticalAlignment="Center"
                Content="全选"
                Checked="SelectAllCheckBox_Checked"
                Unchecked="SelectAllCheckBox_Unchecked" />

            <TextBlock x:Name="MultiSelectCountText" Grid.Column="1"
                VerticalAlignment="Center" FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
                <Button x:Name="MultiSelectPlayButton" Height="32" Padding="8,0"
                    Click="MultiSelectPlayButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" FontSize="12" Glyph="&#xE768;" />
                        <TextBlock Text="播放选中" />
                    </StackPanel>
                </Button>
                <Button x:Name="MultiSelectDeleteButton" Height="32" Padding="8,0"
                    Click="MultiSelectDeleteButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" FontSize="12" Glyph="&#xE74D;" />
                        <TextBlock Text="删除" />
                    </StackPanel>
                </Button>
                <Button x:Name="MultiSelectCancelButton" Height="32" Padding="8,0"
                    Click="MultiSelectCancelButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" FontSize="12" Glyph="&#xE711;" />
                        <TextBlock Text="取消" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ========== 文件夹导航面包屑 ========== -->
        <Grid x:Name="FolderNavigationGrid" Grid.Row="3" Margin="30,10,24,6" Visibility="Collapsed">
            <StackPanel x:Name="FolderBreadcrumbPanel" Orientation="Horizontal" Spacing="0"
                        VerticalAlignment="Center" />
        </Grid>

        <!-- ========== 内容区 ========== -->
        <Grid Grid.Row="4">
            <!-- 全部面板 -->
            <Grid x:Name="AllContentPanel">
                <GridView x:Name="VideoGrid"
                          Margin="17,4,0,24"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="VideoGrid_ItemClick"
                          ShowsScrollingPlaceholders="True"
                          ContainerContentChanging="VideoGrid_ContainerContentChanging"
                          ItemTemplate="{StaticResource VideoCardTemplate}">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GridViewItem">
                                        <Border x:Name="RootBorder"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Margin="0,0,12,12"
                                                Padding="8"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal">
                                                        <VisualState.Setters>
                                                            <Setter Target="RootBorder.Background" Value="Transparent"/>
                                                            <Setter Target="RootBorder.BorderBrush" Value="Transparent"/>
                                                            <Setter Target="CardScale.ScaleX" Value="1"/>
                                                            <Setter Target="CardScale.ScaleY" Value="1"/>
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="PointerOver">
                                                        <VisualState.Setters>
                                                            <Setter Target="RootBorder.Background" Value="{ThemeResource VideoCardPointerOverBackgroundBrush}"/>
                                                            <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource VideoCardPointerOverBorderBrush}"/>
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="Pressed">
                                                        <VisualState.Setters>
                                                            <Setter Target="RootBorder.Background" Value="{ThemeResource VideoCardPressedBackgroundBrush}"/>
                                                            <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource VideoCardPointerOverBorderBrush}"/>
                                                            <Setter Target="CardScale.ScaleX" Value="0.985"/>
                                                            <Setter Target="CardScale.ScaleY" Value="0.985"/>
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="Selected"/>
