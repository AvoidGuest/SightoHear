                    </GridView.ItemContainerStyle>

                    <GridView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderContainerStyle>
                                <Style TargetType="GridViewHeaderItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GridViewHeaderItem">
                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.HeaderContainerStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate x:DataType="models:VideoGroup">
                                    <TextBlock Text="{x:Bind Header}" FontSize="20" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               Margin="10,8,0,8" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </GridView.GroupStyle>
                </GridView>

                <TextBlock x:Name="EmptyStateText"
                           Text="暂无视频，请在设置中添加视频库路径"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
            </Grid>

            <!-- 文件夹面板 -->
            <Grid x:Name="FolderContentPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 文件夹列表头 -->
                <Grid x:Name="FolderListHeader" Grid.Row="0" Margin="17,0,24,0" Padding="12,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="图标" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="文件夹" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="视频" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <ListView x:Name="FolderList" Grid.Row="1"
                          Margin="17,4,0,24"
                          IsItemClickEnabled="True"
                          ItemClick="FolderList_ItemClick"
                          ItemContainerStyle="{StaticResource VideoListViewItemStyle}"
                          ItemTemplate="{StaticResource VideoFolderListItemTemplate}"
                          SelectionMode="None">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromHorizontalOffset="60" FromVerticalOffset="0" />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>

                <GridView x:Name="FolderGrid" Grid.Row="1"
                          Margin="17,4,0,24"
                          IsItemClickEnabled="True"
                          ItemClick="FolderList_ItemClick"
                          ItemTemplate="{StaticResource VideoFolderGridItemTemplate}"
                          SelectionMode="None"
                          Visibility="Collapsed">
                    <GridView.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromHorizontalOffset="60" FromVerticalOffset="0" />
                        </TransitionCollection>
                    </GridView.ItemContainerTransitions>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GridViewItem">
                                        <Border x:Name="RootBorder"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Margin="0,0,12,12"
                                                Padding="8"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal">
                                                        <VisualState.Setters>
                                                            <Setter Target="RootBorder.Background" Value="Transparent"/>
                                                            <Setter Target="RootBorder.BorderBrush" Value="Transparent"/>
                                                            <Setter Target="CardScale.ScaleX" Value="1"/>
                                                            <Setter Target="CardScale.ScaleY" Value="1"/>
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="PointerOver">
                                                        <VisualState.Setters>
                                                            <Setter Target="RootBorder.Background" Value="{ThemeResource VideoCardPointerOverBackgroundBrush}"/>
                                                            <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource VideoCardPointerOverBorderBrush}"/>
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="Pressed">
                                                        <VisualState.Setters>
                                                            <Setter Target="RootBorder.Background" Value="{ThemeResource VideoCardPressedBackgroundBrush}"/>
                                                            <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource VideoCardPointerOverBorderBrush}"/>
                                                            <Setter Target="CardScale.ScaleX" Value="0.985"/>
                                                            <Setter Target="CardScale.ScaleY" Value="0.985"/>
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="Selected"/>
                                                    <VisualState x:Name="SelectedPointerOver">
                                                        <VisualState.Setters>
                                                            <Setter Target="RootBorder.Background" Value="{ThemeResource VideoCardPointerOverBackgroundBrush}"/>
                                                            <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource VideoCardPointerOverBorderBrush}"/>
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="SelectedPressed">
                                                        <VisualState.Setters>
                                                            <Setter Target="RootBorder.Background" Value="{ThemeResource VideoCardPressedBackgroundBrush}"/>
                                                            <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource VideoCardPointerOverBorderBrush}"/>
                                                            <Setter Target="CardScale.ScaleX" Value="0.985"/>
                                                            <Setter Target="CardScale.ScaleY" Value="0.985"/>
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>

                <TextBlock x:Name="FolderEmptyStateText" Grid.Row="1"
                           Text="暂无文件夹数据"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,40,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="Collapsed" />
            </Grid>

            <!-- 收藏面板 -->
            <Grid x:Name="FavoritesContentPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 收藏夹列表头 -->
                <Grid x:Name="FavoritesListHeader" Grid.Row="0" Margin="17,0,24,0" Padding="12,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="图标" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="收藏夹" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="视频" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <ListView x:Name="FavoritesList" Grid.Row="1"
                          Margin="17,4,0,24"
                          IsItemClickEnabled="True"
                          ItemClick="FavoritesList_ItemClick"
                          ItemContainerStyle="{StaticResource VideoListViewItemStyle}"
                          ItemTemplate="{StaticResource VideoFavoriteListItemTemplate}"
                          SelectionMode="None">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>

                <GridView x:Name="FavoritesGrid" Grid.Row="1"
                          Margin="17,4,0,24"
                          IsItemClickEnabled="True"
                          ItemClick="FavoritesList_ItemClick"
                          ItemTemplate="{StaticResource VideoFavoriteGridItemTemplate}"
                          SelectionMode="None"
                          Visibility="Collapsed">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GridViewItem">
                                        <Border x:Name="RootBorder"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Margin="0,0,12,12"
                                                Padding="8"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal">
                                                        <VisualState.Setters>
                                                            <Setter Target="RootBorder.Background" Value="Transparent"/>
                                                            <Setter Target="RootBorder.BorderBrush" Value="Transparent"/>
                                                            <Setter Target="CardScale.ScaleX" Value="1"/>
                                                            <Setter Target="CardScale.ScaleY" Value="1"/>
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="PointerOver">
                                                        <VisualState.Setters>
                                                            <Setter Target="RootBorder.Background" Value="{ThemeResource VideoCardPointerOverBackgroundBrush}"/>
                                                            <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource VideoCardPointerOverBorderBrush}"/>
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="Pressed">
                                                        <VisualState.Setters>
                                                            <Setter Target="RootBorder.Background" Value="{ThemeResource VideoCardPressedBackgroundBrush}"/>
                                                            <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource VideoCardPointerOverBorderBrush}"/>
                                                            <Setter Target="CardScale.ScaleX" Value="0.985"/>
                                                            <Setter Target="CardScale.ScaleY" Value="0.985"/>
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="Selected"/>
                                                    <VisualState x:Name="SelectedPointerOver">
                                                        <VisualState.Setters>
                                                            <Setter Target="RootBorder.Background" Value="{ThemeResource VideoCardPointerOverBackgroundBrush}"/>
                                                            <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource VideoCardPointerOverBorderBrush}"/>
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="SelectedPressed">
                                                        <VisualState.Setters>
                                                            <Setter Target="RootBorder.Background" Value="{ThemeResource VideoCardPressedBackgroundBrush}"/>
                                                            <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource VideoCardPointerOverBorderBrush}"/>
                                                            <Setter Target="CardScale.ScaleX" Value="0.985"/>
                                                            <Setter Target="CardScale.ScaleY" Value="0.985"/>
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>

                <TextBlock x:Name="FavoritesEmptyStateText" Grid.Row="1"
                           Text="暂无收藏夹，点击「新建收藏夹」按钮创建"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,40,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Page>
