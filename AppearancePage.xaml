<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SightoHear.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SightoHear"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style x:Key="SettingsSectionHeaderTextBlockStyle"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}"
               TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,0,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer Margin="24,0,24,0">
            <StackPanel Spacing="{StaticResource SettingsCardSpacing}" Margin="0,16,0,0">
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="50" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </StackPanel.ChildrenTransitions>

                <!-- 主题 -->
                <TextBlock
                    Text="主题"
                    Margin="4,0,0,0"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <!-- 主题颜色 -->
                <controls:SettingsExpander
                    Header="主题颜色"
                    Description="选择应用的主题强调色"
                    IsExpanded="False">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE790;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left" HorizontalContentAlignment="Left">
                            <StackPanel Padding="0,8">
                                <StackPanel Orientation="Horizontal">
                                    <GridView x:Name="ColorGridView"
                                              ItemsSource="{x:Bind Colors}"
                                              SelectionMode="Single"
                                              IsItemClickEnabled="False"
                                              SelectedIndex="1"
                                              SelectionChanged="ColorGridView_SelectionChanged">
                                        <GridView.ItemTemplate>
                                            <DataTemplate x:DataType="Brush">
                                                <Border Width="32" Height="32" CornerRadius="4" Background="{Binding}" />
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                        <GridView.ItemContainerStyle>
                                            <Style TargetType="GridViewItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="4" />
                                                <Setter Property="MinWidth" Value="0" />
                                                <Setter Property="MinHeight" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="GridViewItem">
                                                            <Grid>
                                                                <ContentPresenter x:Name="ContentPresenter"
                                                                                  Content="{TemplateBinding Content}"
                                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                                <Border x:Name="SelectionBorder"
                                                                        BorderBrush="Transparent"
                                                                        BorderThickness="2"
                                                                        CornerRadius="4"
                                                                        Margin="-2"
                                                                        IsHitTestVisible="False" />
                                                                <VisualStateManager.VisualStateGroups>
                                                                    <VisualStateGroup x:Name="CommonStates">
                                                                        <VisualState x:Name="Normal" />
                                                                        <VisualState x:Name="Selected">
                                                                            <VisualState.Setters>
                                                                                <Setter Target="SelectionBorder.BorderBrush" Value="{ThemeResource ColorSelectionBorderBrush}" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                        <VisualState x:Name="SelectedPointerOver">
                                                                            <VisualState.Setters>
                                                                                <Setter Target="SelectionBorder.BorderBrush" Value="{ThemeResource ColorSelectionBorderBrush}" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                        <VisualState x:Name="SelectedPressed">
                                                                            <VisualState.Setters>
                                                                                <Setter Target="SelectionBorder.BorderBrush" Value="{ThemeResource ColorSelectionBorderBrush}" />
                                                                            </VisualState.Setters>
                                                                        </VisualState>
                                                                    </VisualStateGroup>
                                                                </VisualStateManager.VisualStateGroups>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GridView.ItemContainerStyle>
                                    </GridView>
                                    <controls:ColorPickerButton x:Name="ColorPickerButton"
                                            Margin="4,-12,4,0"
                                            VerticalAlignment="Center" />
                                </StackPanel>
                                <CheckBox x:Name="WindowsThemeCheckBox"
                                          Content="使用 Windows 主题颜色"
                                          Margin="0,12,0,0"
                                          Checked="WindowsThemeCheckBox_Checked"
                                          Unchecked="WindowsThemeCheckBox_Unchecked" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!-- 深浅色模式 -->
                <controls:SettingsCard
                    x:Name="ThemeModeCard"
                    Header="深浅色模式"
                    Description="选择界面使用浅色还是深色外观">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE793;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="ThemeModeComboBox"
                        MinWidth="150"
                        SelectionChanged="ThemeModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="跟随系统设置" />
                        <ComboBoxItem Content="浅色模式" />
                        <ComboBoxItem Content="深色模式" />
                    </ComboBox>
                </controls:SettingsCard>

                <!-- 背景 -->
                <TextBlock
                    Text="背景"
                    Margin="4,0,0,0"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <!-- 背景材质 -->
                <controls:SettingsExpander
                    Header="背景材质"
                    Description="选择窗口背景的材质效果"
                    IsExpanded="False">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE771;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <ComboBox
                        x:Name="BackdropComboBox"
                        MinWidth="110"
                        SelectionChanged="BackdropComboBox_SelectionChanged">
                        <ComboBoxItem Content="云母" />
                        <ComboBoxItem Content="亚克力" />
                        <ComboBoxItem Content="无" />
                    </ComboBox>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard
                            x:Name="KeepContentMicaCard"
                            Header="内容区域保持云母"
                            Description="开启后只有标题栏和侧边栏使用所选材质，页面内容区域始终为云母">
                            <ToggleSwitch
                                x:Name="KeepContentMicaToggle"
                                MinWidth="0"
                                OffContent=""
                                OnContent=""
                                Toggled="KeepContentMicaToggle_Toggled" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <!-- 窗口 -->
                <TextBlock
                    Text="窗口"
                    Margin="4,0,0,0"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <!-- 记住窗口大小 -->
                <controls:SettingsCard Header="记住窗口大小" Description="下次启动时恢复上次关闭前的窗口大小">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE737;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        x:Name="RememberWindowSizeToggle"
                        Tag="RememberWindowSize"
                        MinWidth="0"
                        OnContent=""
                        OffContent=""
                        Toggled="RememberSetting_Toggled" />
                </controls:SettingsCard>

                <!-- 记住窗口位置 -->
                <controls:SettingsCard Header="记住窗口位置" Description="下次启动时恢复上次关闭前的窗口位置">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE7C4;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        x:Name="RememberWindowPositionToggle"
                        Tag="RememberWindowPosition"
                        MinWidth="0"
                        OnContent=""
                        OffContent=""
                        Toggled="RememberSetting_Toggled" />
                </controls:SettingsCard>

                <!-- 允许应用多开 -->
                <controls:SettingsCard Header="允许应用多开" Description="开启后可以同时运行多个程序窗口；关闭后重复启动只会把已有窗口带到前台">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xF7ED;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        x:Name="AllowMultiInstanceToggle"
                        Tag="AllowMultiInstance"
                        MinWidth="0"
                        OnContent=""
                        OffContent=""
                        Toggled="RememberSetting_Toggled" />
                </controls:SettingsCard>

                <!-- 交互 -->
                <TextBlock
                    Text="交互"
                    Margin="4,0,0,0"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <!-- 确认弹窗按钮反转 -->
                <controls:SettingsCard Header="确认弹窗按钮反转" Description="把删除、还原等确认弹窗的主次按钮位置互换，方便习惯在左侧点击确认的用户">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE75B;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch
                        x:Name="ConfirmDialogReverseToggle"
                        Tag="ConfirmDialogReverse"
                        MinWidth="0"
                        OnContent=""
                        OffContent=""
                        Toggled="RememberSetting_Toggled" />
                </controls:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
