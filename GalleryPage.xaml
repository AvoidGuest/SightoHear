<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SightoHear.GalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SightoHear"
    xmlns:models="using:SightoHear.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled"
    Background="Transparent">

    <Page.Resources>
            <local:FilePathToImageConverter x:Key="VideoCoverConverter" />

            <!-- ★ 卡片模板：Grid 代替 Border（Grid 原生支持 CornerRadius+Border，少一层布局） -->
        <DataTemplate x:Key="ImageCardTemplate" x:DataType="models:MediaItem">
            <Grid Width="{x:Bind GalleryCardWidth}"
                  Height="{x:Bind GalleryCardHeight}"
                  MinWidth="72"
                  Tag="{x:Bind}"
                  CornerRadius="8"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  Tapped="GalleryItem_Tapped"
                  RightTapped="Item_RightTapped">
                <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE8B9;" FontSize="32"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Image x:Name="ThumbnailImage"
                       Tag="{x:Bind}"
                       Loaded="ThumbnailImage_Loaded"
                       Unloaded="ThumbnailImage_Unloaded"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"/>
                <CheckBox x:Name="ItemCheckBox" MinWidth="0"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,4,4,0"
                    Visibility="Collapsed"
                    Checked="ImageItemCheckBox_Checked"
                    Unchecked="ImageItemCheckBox_Unchecked" />
                <!-- 图片信息栏（图库设置：卡片显示图片信息） -->
                <Border x:Name="ImageInfoBar"
                        Visibility="{x:Bind GalleryInfoVisibility}"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource SystemFillColorSolidNeutralBackgroundBrush}"
                        Opacity="0.85"
                        CornerRadius="0,0,8,8"
                        Padding="8,4">
                    <StackPanel>
                        <TextBlock Text="{x:Bind FileName}"
                                   FontSize="11"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind ImageInfoText}"
                                   FontSize="10"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ★ 行模板：每行是 ItemsRepeater 的最小虚拟化单元（4~10 张卡片 + 可选日期标题） -->
        <DataTemplate x:Key="GalleryRowTemplate" x:DataType="models:GalleryRow">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind Header}"
                           Visibility="{x:Bind HeaderVisibility}"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Margin="6,4,0,2"/>
                <ItemsControl ItemsSource="{x:Bind Items}"
                              ItemTemplate="{StaticResource ImageCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

            <!-- 文件夹列表项模板 -->
            <DataTemplate x:Key="GalleryFolderListItemTemplate" x:DataType="models:GalleryFolderGroup">
                <Border
                    Height="64"
                    Padding="12,8"
                    Tag="{x:Bind}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    DoubleTapped="FolderItem_DoubleTapped"
                    RightTapped="FolderItem_RightTapped">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="40" Height="40"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="4">
                            <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE8B7;" FontSize="18"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind FolderPath}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind ImageCountText}"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <CheckBox
                            x:Name="ItemCheckBox"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Checked="FolderItemCheckBox_Checked"
                            Unchecked="FolderItemCheckBox_Unchecked" />
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- 文件夹网格项模板 -->
            <DataTemplate x:Key="GalleryFolderGridItemTemplate" x:DataType="models:GalleryFolderGroup">
                <StackPanel Width="220" Height="152" Background="Transparent"
                            DoubleTapped="FolderItem_DoubleTapped" RightTapped="FolderItem_RightTapped"
                            Tag="{x:Bind}">
                    <Border Width="220" Height="124" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid>
                            <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE8B7;" FontSize="40"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <CheckBox x:Name="ItemCheckBox" MinWidth="0"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,4,4,0"
                                Visibility="Collapsed"
                                Checked="FolderItemCheckBox_Checked"
                                Unchecked="FolderItemCheckBox_Unchecked" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{x:Bind DisplayName}" FontSize="13" Height="20"
                               MaxLines="1" TextTrimming="CharacterEllipsis"
                               Width="220" Margin="0,8,0,0" />
                </StackPanel>
            </DataTemplate>

            <!-- 收藏夹列表项模板 -->
            <DataTemplate x:Key="GalleryFavoriteListItemTemplate" x:DataType="models:Playlist">
                <Border
                    Height="64"
                    Padding="12,8"
                    Tag="{x:Bind}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    DoubleTapped="FavoriteItem_DoubleTapped"
                    RightTapped="FavoriteItem_RightTapped">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="40" Height="40"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="4">
                            <Grid>
                                <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xEB9F;"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Image Source="{x:Bind CoverDisplayPath, Converter={StaticResource VideoCoverConverter}}"
                                       Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind SongCountText}"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <CheckBox
                            x:Name="ItemCheckBox"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Checked="FavoriteItemCheckBox_Checked"
                            Unchecked="FavoriteItemCheckBox_Unchecked" />
                    </Grid>
                </Border>
            </DataTemplate>
            <!-- 收藏夹网格项模板 -->
            <DataTemplate x:Key="GalleryFavoriteGridItemTemplate" x:DataType="models:Playlist">
                <StackPanel Width="220" Height="152" Background="Transparent"
                            DoubleTapped="FavoriteItem_DoubleTapped" RightTapped="FavoriteItem_RightTapped"
                            Tag="{x:Bind}">
                    <Border Width="220" Height="124" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Grid>
                            <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xEB9F;" FontSize="40"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Image Source="{x:Bind CoverDisplayPath, Converter={StaticResource VideoCoverConverter}}"
                                   Stretch="UniformToFill" />
                            <CheckBox x:Name="ItemCheckBox" MinWidth="0"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,4,4,0"
                                Visibility="Collapsed"
                                Checked="FavoriteItemCheckBox_Checked"
                                Unchecked="FavoriteItemCheckBox_Unchecked" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{x:Bind Name}" FontSize="13" Height="20"
                               MaxLines="1" TextTrimming="CharacterEllipsis"
                               Width="220" Margin="0,8,0,0" />
                </StackPanel>
            </DataTemplate>

            <Style x:Key="GalleryListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <!-- CollectionViewSource：支持分组（保留备用） -->
            <CollectionViewSource x:Name="GroupedCVS" IsSourceGrouped="True" ItemsPath="Items" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,24,28,0" VerticalAlignment="Center">
            <TextBlock Text="图库" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="LibraryManageButton" Content="媒体库管理" Click="LibraryManageButton_Click"
                        Height="32" Padding="12,0"/>
                <Button x:Name="EnterPlayerButton" Content="进入看图器" Click="EnterPlayerButton_Click"
                        Height="32" Padding="16,0"/>
            </StackPanel>
        </Grid>

        <!-- Tab Bar -->
        <Border Grid.Row="1" x:Name="TabBarHost" Margin="24,10,0,0"
                HorizontalAlignment="Left"
                Height="32"
                CornerRadius="4"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <local:TabCursorGrid x:Name="TabSelectorGrid" Background="Transparent">
                <!-- Hover overlays (per tab, shown only on non-selected tab hover) -->
                <Border x:Name="HoverOverlay0" CornerRadius="3" Width="52"
                        HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        Margin="4,4,0,4" IsHitTestVisible="False"
                        Background="Transparent" />
                <Border x:Name="HoverOverlay1" CornerRadius="3" Width="52"
                        HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        Margin="64,4,0,4" IsHitTestVisible="False"
                        Background="Transparent" />
                <Border x:Name="HoverOverlay2" CornerRadius="3" Width="52"
                        HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        Margin="124,4,0,4" IsHitTestVisible="False"
                        Background="Transparent" />

                <!-- Sliding indicator -->
                <Border x:Name="TabIndicator" Width="60" CornerRadius="3"
                        HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        IsHitTestVisible="False"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="IndicatorTransform" />
                    </Border.RenderTransform>
                </Border>

                <!-- Segment labels (display only, no hit test) -->
                <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                    <Border Width="60" Background="Transparent">
                        <Button MinWidth="0" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                UseSystemFocusVisuals="False">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                            </Button.Resources>
                            <TextBlock x:Name="TabText0" Text="全部" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Border>
                    <Border Width="60" Background="Transparent">
                        <Button MinWidth="0" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                UseSystemFocusVisuals="False">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                            </Button.Resources>
                            <TextBlock x:Name="TabText1" Text="相册" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Border>
                    <Border Width="60" Background="Transparent">
                        <Button MinWidth="0" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                UseSystemFocusVisuals="False">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                            </Button.Resources>
                            <TextBlock x:Name="TabText2" Text="文件夹" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Border>
                </StackPanel>
            </local:TabCursorGrid>
        </Border>

        <Grid x:Name="ToolbarGrid" Grid.Row="2" Margin="24,12,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="搜索图库" QueryIcon="Find" 
                            MinWidth="300" HorizontalAlignment="Left" TextChanged="SearchBox_TextChanged" />

            <TextBlock x:Name="ScanStatusText" Grid.Column="2" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />

            <Button x:Name="RefreshButton" Grid.Column="3" Margin="0,0,8,0" Click="RefreshButton_Click" Height="32" VerticalAlignment="Center" Padding="8,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE72C;" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="刷新" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <ToggleButton x:Name="MultiSelectToggleButton" Grid.Column="4"
                Height="32" Margin="0,0,8,0" Padding="8,0"
                Click="MultiSelectToggleButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" FontSize="12" Glyph="&#xEA98;" />
                    <TextBlock Text="多选" />
                </StackPanel>
            </ToggleButton>

            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox x:Name="ViewModeComboBox" SelectedIndex="0" SelectionChanged="ViewModeComboBox_SelectionChanged" Height="32" VerticalAlignment="Center">
                    <ComboBoxItem Content="日期分开" />
                    <ComboBoxItem Content="连续平铺" />
                </ComboBox>
                <ComboBox x:Name="SortComboBox" SelectedIndex="1" SelectionChanged="SortComboBox_SelectionChanged" Height="32" VerticalAlignment="Center">
                    <ComboBoxItem Content="A-Z" />
                    <ComboBoxItem Content="日期" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- ========== 文件夹标签工具栏 ========== -->
        <Grid x:Name="FolderToolbarGrid" Grid.Row="2" Margin="24,12,24,5" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox x:Name="FolderSearchBox" Grid.Column="0"
                            MinWidth="300" PlaceholderText="搜索文件夹" QueryIcon="Find"
                            TextChanged="FolderSearchBox_TextChanged" />

            <Button x:Name="FolderRefreshButton" Grid.Column="2" Height="32"
                    Margin="0,0,8,0" Padding="8,0" Click="FolderRefreshButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" FontSize="12" Glyph="&#xE72C;" />
                    <TextBlock Text="刷新" />
                </StackPanel>
            </Button>

            <ToggleButton x:Name="FolderMultiSelectToggleButton" Grid.Column="3"
                Height="32" Margin="0,0,8,0" Padding="8,0"
                Click="FolderMultiSelectToggleButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" FontSize="12" Glyph="&#xEA98;" />
                    <TextBlock Text="多选" />
                </StackPanel>
            </ToggleButton>

            <ComboBox x:Name="FolderViewModeComboBox" Grid.Column="4" Height="32"
                      Margin="0,0,8,0" SelectedIndex="1"
                      SelectionChanged="FolderViewModeComboBox_SelectionChanged">
                <ComboBoxItem Content="列表" />
                <ComboBoxItem Content="网格" />
            </ComboBox>
            <ComboBox x:Name="FolderSortComboBox" Grid.Column="5" Height="32"
                      SelectedIndex="0" SelectionChanged="FolderSortComboBox_SelectionChanged">
                <ComboBoxItem Content="名称" />
                <ComboBoxItem Content="图片数" />
            </ComboBox>
        </Grid>

        <!-- ========== 收藏标签工具栏 ========== -->
        <Grid x:Name="FavoritesToolbarGrid" Grid.Row="2" Margin="24,12,24,5" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox x:Name="FavoritesSearchBox" Grid.Column="0"
                            MinWidth="300" PlaceholderText="搜索相册" QueryIcon="Find"
                            TextChanged="FavoritesSearchBox_TextChanged" />

            <Button x:Name="FavoritesRefreshButton" Grid.Column="2" Height="32"
                    Margin="0,0,8,0" Padding="8,0" Click="FavoritesRefreshButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" FontSize="12" Glyph="&#xE72C;" />
                    <TextBlock Text="刷新" />
                </StackPanel>
            </Button>

            <Button x:Name="CreateFavoriteButton" Grid.Column="3" Height="32"
                    Margin="0,0,8,0" Padding="8,0" Click="CreateFavoriteButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" FontSize="12" Glyph="&#xE710;" />
                    <TextBlock Text="新建相册" />
                </StackPanel>
            </Button>

            <ToggleButton x:Name="FavoritesMultiSelectToggleButton" Grid.Column="4"
                Height="32" Margin="0,0,8,0" Padding="8,0"
                Click="FavoritesMultiSelectToggleButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" FontSize="12" Glyph="&#xEA98;" />
                    <TextBlock Text="多选" />
                </StackPanel>
            </ToggleButton>

            <ComboBox x:Name="FavoritesViewModeComboBox" Grid.Column="5" Height="32"
                      Margin="0,0,8,0" SelectedIndex="1"
                      SelectionChanged="FavoritesViewModeComboBox_SelectionChanged">
                <ComboBoxItem Content="列表" />
                <ComboBoxItem Content="网格" />
            </ComboBox>
            <ComboBox x:Name="FavoritesSortComboBox" Grid.Column="6" Height="32"
                      SelectedIndex="0" SelectionChanged="FavoritesSortComboBox_SelectionChanged">
                <ComboBoxItem Content="名称" />
                <ComboBoxItem Content="创建时间" />
            </ComboBox>
        </Grid>

        <!-- ========== 多选工具栏 ========== -->
        <Grid x:Name="MultiSelectToolbarGrid" Grid.Row="2" Margin="24,12,24,5" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="SelectAllCheckBox" Grid.Column="0"
                Margin="0,0,12,0" VerticalAlignment="Center"
                Content="全选"
                Checked="SelectAllCheckBox_Checked"
                Unchecked="SelectAllCheckBox_Unchecked" />
            <TextBlock x:Name="MultiSelectCountText" Grid.Column="1"
                VerticalAlignment="Center" FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                <Button x:Name="MultiSelectDeleteButton" Height="32" Padding="8,0"
                    Click="MultiSelectDeleteButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" FontSize="12" Glyph="&#xE74D;" />
                        <TextBlock Text="删除" />
                    </StackPanel>
                </Button>
                <Button x:Name="MultiSelectCancelButton" Height="32" Padding="8,0"
                    Click="MultiSelectCancelButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" FontSize="12" Glyph="&#xE711;" />
                        <TextBlock Text="取消" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ========== 文件夹导航面包屑 ========== -->
        <Grid x:Name="FolderNavigationGrid" Grid.Row="3" Margin="30,10,24,6" Visibility="Collapsed">
            <StackPanel x:Name="FolderBreadcrumbPanel" Orientation="Horizontal" Spacing="0"
                        VerticalAlignment="Center" />
        </Grid>

        <!-- ========== 内容区 ========== -->
        <Grid Grid.Row="4">
            <!-- 全部面板 -->
            <Grid x:Name="AllContentPanel">
                <ScrollViewer x:Name="GalleryScrollViewer"
                              Padding="24,10,24,18"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Auto"
                              SizeChanged="GalleryScrollViewer_SizeChanged">
                    <ItemsRepeater x:Name="ImageRepeater"
                                   ItemsSource="{x:Null}"
                                   ItemTemplate="{StaticResource GalleryRowTemplate}"
                                   VerticalCacheLength="3"
                                   ElementPrepared="ImageRepeater_ElementPrepared"
                                   ElementClearing="ImageRepeater_ElementClearing">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8"/>
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>

                <TextBlock x:Name="EmptyStateText"
                           Text="暂无图片，请在设置中添加图片库路径"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,40,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="Collapsed" />
            </Grid>

            <!-- 文件夹面板 -->
            <Grid x:Name="FolderContentPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 文件夹列表头 -->
                <Grid x:Name="FolderListHeader" Grid.Row="0" Margin="17,0,24,0" Padding="12,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="图标" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="文件夹" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="图片" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <ListView x:Name="FolderList" Grid.Row="1"
                          Margin="17,4,0,24"
                          IsItemClickEnabled="True"
                          ItemClick="FolderList_ItemClick"
                          ItemContainerStyle="{StaticResource GalleryListViewItemStyle}"
                          ItemTemplate="{StaticResource GalleryFolderListItemTemplate}"
                          SelectionMode="None">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromHorizontalOffset="60" FromVerticalOffset="0" />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>

                <GridView x:Name="FolderGrid" Grid.Row="1"
                          Margin="17,4,0,24"
                          IsItemClickEnabled="True"
                          ItemClick="FolderList_ItemClick"
                          ItemTemplate="{StaticResource GalleryFolderGridItemTemplate}"
                          SelectionMode="None"
                          Visibility="Collapsed">
                    <GridView.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromHorizontalOffset="60" FromVerticalOffset="0" />
                        </TransitionCollection>
                    </GridView.ItemContainerTransitions>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GridViewItem">
                                        <Border x:Name="RootBorder"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Margin="0,0,12,12"
                                                Padding="8"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal">
                                                        <VisualState.Setters>
                                                            <Setter Target="RootBorder.Background" Value="Transparent"/>
                                                            <Setter Target="RootBorder.BorderBrush" Value="Transparent"/>
                                                            <Setter Target="CardScale.ScaleX" Value="1"/>
                                                            <Setter Target="CardScale.ScaleY" Value="1"/>
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="PointerOver">
                                                        <VisualState.Setters>
                                                            <Setter Target="RootBorder.Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                                                            <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="Pressed">
                                                        <VisualState.Setters>
                                                            <Setter Target="RootBorder.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                                                            <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                                            <Setter Target="CardScale.ScaleX" Value="0.985"/>
                                                            <Setter Target="CardScale.ScaleY" Value="0.985"/>
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>

                <TextBlock x:Name="FolderEmptyStateText" Grid.Row="1"
                           Text="暂无文件夹数据"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,40,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="Collapsed" />
            </Grid>

            <!-- 收藏面板 -->
            <Grid x:Name="FavoritesContentPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 收藏夹列表头 -->
                <Grid x:Name="FavoritesListHeader" Grid.Row="0" Margin="17,0,24,0" Padding="12,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="图标" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="相册" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="图片" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <ListView x:Name="FavoritesList" Grid.Row="1"
                          Margin="17,4,0,24"
                          IsItemClickEnabled="True"
                          ItemClick="FavoritesList_ItemClick"
                          ItemContainerStyle="{StaticResource GalleryListViewItemStyle}"
                          ItemTemplate="{StaticResource GalleryFavoriteListItemTemplate}"
                          SelectionMode="None">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>

                <GridView x:Name="FavoritesGrid" Grid.Row="1"
                          Margin="17,4,0,24"
                          IsItemClickEnabled="True"
                          ItemClick="FavoritesList_ItemClick"
                          ItemTemplate="{StaticResource GalleryFavoriteGridItemTemplate}"
                          SelectionMode="None"
                          Visibility="Collapsed">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GridViewItem">
                                        <Border x:Name="RootBorder"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Margin="0,0,12,12"
                                                Padding="8"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal">
                                                        <VisualState.Setters>
                                                            <Setter Target="RootBorder.Background" Value="Transparent"/>
                                                            <Setter Target="RootBorder.BorderBrush" Value="Transparent"/>
                                                            <Setter Target="CardScale.ScaleX" Value="1"/>
                                                            <Setter Target="CardScale.ScaleY" Value="1"/>
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="PointerOver">
                                                        <VisualState.Setters>
                                                            <Setter Target="RootBorder.Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                                                            <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="Pressed">
                                                        <VisualState.Setters>
                                                            <Setter Target="RootBorder.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}"/>
                                                            <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                                                            <Setter Target="CardScale.ScaleX" Value="0.985"/>
                                                            <Setter Target="CardScale.ScaleY" Value="0.985"/>
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>

                <TextBlock x:Name="FavoritesEmptyStateText" Grid.Row="1"
                           Text="暂无相册，点击「新建相册」按钮创建"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,40,0,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Page>
