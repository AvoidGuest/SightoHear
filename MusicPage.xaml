                         Text="{x:Bind SongCountText}"
                         VerticalAlignment="Center"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                     <CheckBox
                         x:Name="ItemCheckBox"
                         Grid.Column="3"
                         VerticalAlignment="Center"
                         Visibility="Collapsed"
                         Checked="FolderItemCheckBox_Checked"
                         Unchecked="FolderItemCheckBox_Unchecked" />
                 </Grid>
            </Border>
        </DataTemplate>
