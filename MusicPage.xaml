                        <Border
                            Width="36" Height="36"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="4">
                            <Image Source="{x:Bind CoverDisplayPath, Converter={StaticResource MusicCoverConverter}}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" MaxLines="1" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind SongCountText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                    <CheckBox
                        x:Name="ItemCheckBox"
                        MinWidth="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0"
                        Visibility="Collapsed"
                        Checked="PlaylistItemCheckBox_Checked"
                        Unchecked="PlaylistItemCheckBox_Unchecked" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="AlbumWaterfallItemTemplate" x:DataType="models:AlbumGroup">
