        <DataTemplate x:Key="FolderGridItemTemplate" x:DataType="models:FolderGroup">
            <Border
                Width="176"
                Height="200"
                Padding="16,20,16,12"
                Tag="{x:Bind}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
