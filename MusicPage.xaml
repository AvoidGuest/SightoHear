                    x:Name="MusicList"
                    Grid.Row="1"
                    Padding="0,0,24,8"
                    IsItemClickEnabled="True"
                    ItemClick="MusicView_ItemClick"
                    ItemContainerStyle="{StaticResource MusicListViewItemStyle}"
                    ItemTemplate="{StaticResource MusicListItemTemplate}"
                    SelectionMode="None">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>

                <GridView
                    x:Name="MusicGrid"
                    Grid.Row="1"
                    Padding="24,0,24,8"
                    IsItemClickEnabled="True"
                    ItemClick="MusicView_ItemClick"
                    ItemTemplate="{StaticResource MusicGridItemTemplate}"
                    SelectionMode="None"
                    Visibility="Collapsed">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>

                <GridView
                    x:Name="MusicWaterfallGrid"
                    Grid.Row="1"
                    Padding="24,0,24,8"
                    IsItemClickEnabled="True"
                    ItemClick="MusicView_ItemClick"
                    ItemTemplate="{StaticResource MusicWaterfallItemTemplate}"
                    SelectionMode="None"
                    SizeChanged="MusicWaterfallGrid_SizeChanged"
                    Visibility="Collapsed">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,4,4" />
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>

                <TextBlock
                    x:Name="EmptyStateText"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="暂无音乐，请在设置中添加音乐库路径"
                    Visibility="Collapsed" />
            </Grid>

            <Border x:Name="PlaylistContentHost" Padding="0,0,24,8" Visibility="Collapsed">
                <Grid>
                    <ListView
                        x:Name="PlaylistList"
                        Margin="0,0,0,0"
                        Padding="0,0,0,0"
                        IsItemClickEnabled="True"
                        ItemClick="PlaylistGrid_ItemClick"
                        ItemContainerStyle="{StaticResource MusicListViewItemStyle}"
                        ItemTemplate="{StaticResource PlaylistListItemTemplate}"
                        SelectionMode="None"
                        Visibility="Collapsed">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>

                    <GridView
                        x:Name="PlaylistGrid"
                        Margin="0,0,0,0"
                        Padding="24,0,0,0"
                        IsItemClickEnabled="True"
                        ItemClick="PlaylistGrid_ItemClick"
                        ItemTemplate="{StaticResource PlaylistGridItemTemplate}"
                        SelectionMode="None"
                        Visibility="Visible">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>

                    <GridView
                        x:Name="PlaylistWaterfallGrid"
                        Margin="0,0,0,0"
                        Padding="24,0,0,0"
                        IsItemClickEnabled="True"
                        ItemClick="PlaylistGrid_ItemClick"
                        ItemTemplate="{StaticResource PlaylistWaterfallItemTemplate}"
                        SelectionMode="None"
                        SizeChanged="PlaylistWaterfallGrid_SizeChanged"
                        Visibility="Collapsed">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,4,4" />
                        </Style>
                        </GridView.ItemContainerStyle>
                    </GridView>

                    <TextBlock
                        x:Name="PlaylistEmptyStateText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="暂无歌单，点击「创建」按钮新建"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- 歌手 -->
            <Grid x:Name="ArtistContentPanel" Margin="0,0,0,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="ArtistListHeader" Grid.Row="0" Margin="24,0" Padding="12,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="头像" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="歌手" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="专辑" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="歌曲" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <ListView
                    x:Name="ArtistList"
                    Grid.Row="1"
                    Padding="0,0,24,8"
                    IsItemClickEnabled="True"
                    ItemClick="ArtistList_ItemClick"
                    ItemContainerStyle="{StaticResource MusicListViewItemStyle}"
                    ItemTemplate="{StaticResource ArtistListItemTemplate}"
                    SelectionMode="None">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>

                <GridView
                    x:Name="ArtistGrid"
                    Grid.Row="1"
                    Padding="24,0,24,8"
                    IsItemClickEnabled="True"
                    ItemClick="ArtistList_ItemClick"
                    ItemTemplate="{StaticResource ArtistGridItemTemplate}"
                    SelectionMode="None"
                    Visibility="Collapsed">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>

                <GridView
                    x:Name="ArtistWaterfallGrid"
                    Grid.Row="1"
                    Padding="24,0,24,8"
                    IsItemClickEnabled="True"
                    ItemClick="ArtistList_ItemClick"
                    ItemTemplate="{StaticResource ArtistWaterfallItemTemplate}"
                    SelectionMode="None"
                    SizeChanged="ArtistWaterfallGrid_SizeChanged"
                    Visibility="Collapsed">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid
                                Orientation="Horizontal"
                                MaximumRowsOrColumns="4" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,4,4" />
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>

                <TextBlock
                    x:Name="ArtistEmptyStateText"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="暂无歌手数据"
                    Visibility="Collapsed" />
            </Grid>

            <!-- 专辑 -->
            <Grid x:Name="AlbumContentPanel" Margin="0,0,0,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="AlbumListHeader" Grid.Row="0" Margin="24,0" Padding="12,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="封面" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="专辑" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="歌手" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="年份" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="歌曲" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <ListView
                    x:Name="AlbumList"
                    Grid.Row="1"
                    Padding="0,0,24,8"
                    IsItemClickEnabled="True"
                    ItemClick="AlbumList_ItemClick"
                    ItemContainerStyle="{StaticResource MusicListViewItemStyle}"
                    ItemTemplate="{StaticResource AlbumListItemTemplate}"
                    SelectionMode="None">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>

                <GridView
                    x:Name="AlbumGrid"
                    Grid.Row="1"
                    Padding="24,0,24,8"
                    IsItemClickEnabled="True"
                    ItemClick="AlbumList_ItemClick"
                    ItemTemplate="{StaticResource AlbumGridItemTemplate}"
                    SelectionMode="None"
                    Visibility="Collapsed">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>

                <GridView
                    x:Name="AlbumWaterfallGrid"
                    Grid.Row="1"
                    Padding="24,0,24,8"
                    IsItemClickEnabled="True"
                    ItemClick="AlbumList_ItemClick"
                    ItemTemplate="{StaticResource AlbumWaterfallItemTemplate}"
                    SelectionMode="None"
                    SizeChanged="AlbumWaterfallGrid_SizeChanged"
                    Visibility="Collapsed">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,4,4" />
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>

                <TextBlock
                    x:Name="AlbumEmptyStateText"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="暂无专辑数据"
                    Visibility="Collapsed" />
            </Grid>

            <!-- 文件夹 -->
            <Grid x:Name="FolderContentPanel" Margin="0,0,0,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="FolderListHeader" Grid.Row="0" Margin="24,0" Padding="12,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="类型" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="文件夹" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="歌曲" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <ListView
                    x:Name="FolderList"
                    Grid.Row="1"
                    Padding="0,0,24,8"
                    IsItemClickEnabled="True"
                    ItemClick="FolderList_ItemClick"
                    ItemContainerStyle="{StaticResource MusicListViewItemStyle}"
                    ItemTemplate="{StaticResource FolderListItemTemplate}"
                    SelectionMode="None"
                    Visibility="Visible">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromHorizontalOffset="60" FromVerticalOffset="0" />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>

                <GridView
                    x:Name="FolderGrid"
                    Grid.Row="1"
                    Padding="24,0,24,8"
                    IsItemClickEnabled="True"
                    ItemClick="FolderList_ItemClick"
                    ItemTemplate="{StaticResource FolderGridItemTemplate}"
                    SelectionMode="None"
                    Visibility="Collapsed">
                    <GridView.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromHorizontalOffset="60" FromVerticalOffset="0" />
                        </TransitionCollection>
                    </GridView.ItemContainerTransitions>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>

                <GridView
                    x:Name="FolderWaterfallGrid"
                    Grid.Row="1"
                    Padding="24,0,24,8"
                    IsItemClickEnabled="True"
                    ItemClick="FolderList_ItemClick"
                    ItemTemplate="{StaticResource FolderWaterfallItemTemplate}"
                    SelectionMode="None"
                    SizeChanged="FolderWaterfallGrid_SizeChanged"
                    Visibility="Collapsed">
                    <GridView.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromHorizontalOffset="60" FromVerticalOffset="0" />
                        </TransitionCollection>
                    </GridView.ItemContainerTransitions>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,4,4" />
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>

                <TextBlock
                    x:Name="FolderEmptyStateText"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="暂无文件夹数据"
                    Visibility="Collapsed" />
            </Grid>

        </Grid>
    </Grid>
</Page>
