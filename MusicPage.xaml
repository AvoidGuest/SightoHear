        <DataTemplate x:Key="AlbumListItemTemplate" x:DataType="models:AlbumGroup">
            <Border
                Height="64"
                Padding="12,8"
                Tag="{x:Bind}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                DoubleTapped="AlbumItem_DoubleTapped"
                RightTapped="AlbumItem_RightTapped">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>

                     <Border
                         Width="40"
                         Height="40"
                         Background="{ThemeResource ControlFillColorSecondaryBrush}"
                         CornerRadius="4">
                         <Grid>
                             <FontIcon
                                 FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                                 Glyph="&#xE93C;"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                             <Image
                                 Source="{x:Bind CoverFilePath, Converter={StaticResource MusicCoverConverter}}"
                                 Stretch="UniformToFill" />
                         </Grid>
                     </Border>

                     <StackPanel Grid.Column="1" VerticalAlignment="Center">
                         <TextBlock
                             Text="{x:Bind DisplayName}"
                             FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                     </StackPanel>

                     <TextBlock
                         Grid.Column="2"
                         Text="{x:Bind ArtistDisplay}"
                         VerticalAlignment="Center"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         TextTrimming="CharacterEllipsis" />

                     <TextBlock
                         Grid.Column="3"
                         Text="{x:Bind YearText}"
                         VerticalAlignment="Center"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                     <TextBlock
                         Grid.Column="4"
                         Text="{x:Bind SongCountText}"
                         VerticalAlignment="Center"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                     <CheckBox
                         x:Name="ItemCheckBox"
                         Grid.Column="5"
                         VerticalAlignment="Center"
                         Visibility="Collapsed"
                         Checked="AlbumItemCheckBox_Checked"
                         Unchecked="AlbumItemCheckBox_Unchecked" />
                 </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AlbumGridItemTemplate" x:DataType="models:AlbumGroup">
            <Border
                Width="{x:Bind local:MusicPage.MusicCardWidth}"
                Height="{x:Bind local:MusicPage.MusicCardHeight}"
                Padding="12"
                Tag="{x:Bind}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                DoubleTapped="AlbumItem_DoubleTapped"
                RightTapped="AlbumItem_RightTapped">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{x:Bind local:MusicPage.MusicCoverRowHeight}" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="6">
                        <Grid>
                            <FontIcon
                                FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                                FontSize="28"
                                Glyph="&#xE93C;"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Image
                                Source="{x:Bind CoverFilePath, Converter={StaticResource MusicCoverConverter}}"
                                Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel
                        Grid.Row="1"
                        Padding="0,4,0,0">
                        <TextBlock
                            Text="{x:Bind DisplayName}"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind ArtistDisplay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <CheckBox
                        x:Name="ItemCheckBox"
                        MinWidth="0"
                        Grid.Row="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,-8,-8"
                        Visibility="Collapsed"
                        Checked="AlbumItemCheckBox_Checked"
                        Unchecked="AlbumItemCheckBox_Unchecked" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="FolderListItemTemplate" x:DataType="models:FolderGroup">
            <Border
                Height="64"
                Padding="12,8"
                Tag="{x:Bind}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                DoubleTapped="FolderItem_DoubleTapped"
                RightTapped="FolderItem_RightTapped">
