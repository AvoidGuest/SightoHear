                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="50"
                        HorizontalAlignment="Center">
                        <Grid>
                            <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" FontSize="36" Glyph="&#xE8B7;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" MaxLines="1" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind SongCountText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <CheckBox
                        x:Name="ItemCheckBox"
                        MinWidth="0"
                        Grid.Row="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
