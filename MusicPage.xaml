<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SightoHear.MusicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SightoHear"
    xmlns:models="using:SightoHear.Models"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled"
    Background="Transparent">

    <Page.Resources>
        <FontFamily x:Key="FluentSystemIconsRegularFontFamily">/Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular</FontFamily>
        <local:FilePathToImageConverter x:Key="MusicCoverConverter" />

        <Style x:Key="MusicListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="24,0,0,4" />
        </Style>

        <DataTemplate x:Key="MusicListItemTemplate" x:DataType="models:MediaItem">
            <Border
                Height="64"
                Padding="12,8"
                Tag="{x:Bind}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                DoubleTapped="MusicItem_DoubleTapped"
                RightTapped="MusicItem_RightTapped">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="40"
                        Height="40"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="4">
                        <Grid>
                            <FontIcon
                                FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                                Glyph="&#xE8D6;"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Image
                                Source="{x:Bind FilePath, Converter={StaticResource MusicCoverConverter}}"
                                Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind Title}"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind ArtistDisplay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="2"
                        Text="{x:Bind AlbumDisplay}"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        Grid.Column="3"
                        Text="{x:Bind DurationText}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <CheckBox
                        x:Name="ItemCheckBox"
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        PointerPressed="MusicItemCheckBox_PointerPressed"
                        DoubleTapped="MusicItemCheckBox_DoubleTapped"
                        Checked="MusicItemCheckBox_Checked"
                        Unchecked="MusicItemCheckBox_Unchecked" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MusicGridItemTemplate" x:DataType="models:MediaItem">
            <Border
                Width="{x:Bind local:MusicPage.MusicCardWidth}"
                Height="{x:Bind local:MusicPage.MusicCardHeight}"
                Padding="12"
                Tag="{x:Bind}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                DoubleTapped="MusicItem_DoubleTapped"
                RightTapped="MusicItem_RightTapped">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{x:Bind local:MusicPage.MusicCoverRowHeight}" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="4">
                        <Grid>
                            <FontIcon
                                FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                                FontSize="28"
                                Glyph="&#xE8D6;"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Image
                                Source="{x:Bind FilePath, Converter={StaticResource MusicCoverConverter}}"
                                Stretch="Uniform" />
                        </Grid>
                    </Border>
                    <StackPanel
                        Grid.Row="1"
                        Padding="0,4,0,0">
                        <TextBlock
                            Text="{x:Bind Title}"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind ArtistDisplay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <CheckBox
                        x:Name="ItemCheckBox"
                        MinWidth="0"
                        Grid.Row="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,-8,-8"
                        Visibility="Collapsed"
                        PointerPressed="MusicItemCheckBox_PointerPressed"
                        DoubleTapped="MusicItemCheckBox_DoubleTapped"
                        Checked="MusicItemCheckBox_Checked"
                        Unchecked="MusicItemCheckBox_Unchecked" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="PlaylistListItemTemplate" x:DataType="models:Playlist">
            <Border
                Height="64"
                Padding="12,8"
                Tag="{x:Bind}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                DoubleTapped="PlaylistItem_DoubleTapped"
                RightTapped="PlaylistItem_RightTapped">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>

                     <Border
                         Width="40"
                         Height="40"
                         Background="{ThemeResource ControlFillColorSecondaryBrush}"
                         CornerRadius="4">
                         <Grid>
                             <FontIcon
                                 FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                                 Glyph="&#xE93C;"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                             <Image
                                 Source="{x:Bind CoverDisplayPath, Converter={StaticResource MusicCoverConverter}}"
                                 Stretch="UniformToFill" />
                         </Grid>
                     </Border>

                     <StackPanel Grid.Column="1" VerticalAlignment="Center">
                         <TextBlock
                             Text="{x:Bind Name}"
                             FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                     </StackPanel>

                     <TextBlock
                         Grid.Column="2"
                         Text="{x:Bind SongCountText}"
                         VerticalAlignment="Center"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                     <CheckBox
                         x:Name="ItemCheckBox"
                         Grid.Column="3"
                         VerticalAlignment="Center"
                         Visibility="Collapsed"
                         Checked="PlaylistItemCheckBox_Checked"
                         Unchecked="PlaylistItemCheckBox_Unchecked" />
                 </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="PlaylistGridItemTemplate" x:DataType="models:Playlist">
            <Border
                Width="{x:Bind local:MusicPage.MusicCardWidth}"
                Height="{x:Bind local:MusicPage.MusicCardHeight}"
                Padding="12"
                Tag="{x:Bind}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                DoubleTapped="PlaylistItem_DoubleTapped"
                RightTapped="PlaylistItem_RightTapped">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{x:Bind local:MusicPage.MusicCoverRowHeight}" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="4">
                        <Grid>
                            <FontIcon
                                FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                                FontSize="28"
                                Glyph="&#xE93C;"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Image
                                Source="{x:Bind CoverDisplayPath, Converter={StaticResource MusicCoverConverter}}"
                                Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel
                        Grid.Row="1"
                        Padding="0,4,0,0">
                        <TextBlock
                            Text="{x:Bind Name}"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind SongCountText}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <CheckBox
                        x:Name="ItemCheckBox"
                        MinWidth="0"
                        Grid.Row="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,-8,-8"
                        Visibility="Collapsed"
                        Checked="PlaylistItemCheckBox_Checked"
                        Unchecked="PlaylistItemCheckBox_Unchecked" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ArtistListItemTemplate" x:DataType="models:ArtistGroup">
            <Border
                Height="64"
                Padding="12,8"
                Tag="{x:Bind}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                DoubleTapped="ArtistItem_DoubleTapped"
                RightTapped="ArtistItem_RightTapped">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>

                     <Border
                         Width="40"
                         Height="40"
                         Background="{ThemeResource ControlFillColorSecondaryBrush}"
                         CornerRadius="20">
                         <Grid>
                               <FontIcon
                                   FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                                   Glyph="&#xE77B;"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                              <Image
                                  Source="{x:Bind CoverFilePath, Converter={StaticResource MusicCoverConverter}}"
                                  Stretch="UniformToFill" />
                          </Grid>
                      </Border>

                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock
                              Text="{x:Bind DisplayName}"
                              FontWeight="SemiBold"
                              TextTrimming="CharacterEllipsis" />
                      </StackPanel>

                      <TextBlock
                          Grid.Column="2"
                          Text="{x:Bind AlbumCountText}"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                      <TextBlock
                          Grid.Column="3"
                          Text="{x:Bind SongCountText}"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                      <CheckBox
                          x:Name="ItemCheckBox"
                          Grid.Column="4"
                          VerticalAlignment="Center"
                          Visibility="Collapsed"
                          Checked="ArtistItemCheckBox_Checked"
                          Unchecked="ArtistItemCheckBox_Unchecked" />
                  </Grid>
              </Border>
          </DataTemplate>

          <DataTemplate x:Key="ArtistGridItemTemplate" x:DataType="models:ArtistGroup">
            <Border
                Width="176"
                Height="200"
                Padding="16,20,16,12"
                Tag="{x:Bind}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                DoubleTapped="ArtistItem_DoubleTapped"
                RightTapped="ArtistItem_RightTapped">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border
                        Width="100"
                        Height="100"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="50"
                        HorizontalAlignment="Center">
                        <Grid>
                            <FontIcon
                                FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                                FontSize="28"
                                Glyph="&#xE77B;"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Image
                                Source="{x:Bind CoverFilePath, Converter={StaticResource MusicCoverConverter}}"
                                Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="2">
                        <TextBlock
                            Text="{x:Bind DisplayName}"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            HorizontalAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind SongCountText}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            HorizontalAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <CheckBox
                        x:Name="ItemCheckBox"
                        MinWidth="0"
                        Grid.Row="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,-8,-8"
                        Visibility="Collapsed"
                        Checked="ArtistItemCheckBox_Checked"
                        Unchecked="ArtistItemCheckBox_Unchecked" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ArtistWaterfallItemTemplate" x:DataType="models:ArtistGroup">
             <Border
                Height="60"
                Padding="12,8"
                Tag="{x:Bind}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                DoubleTapped="ArtistItem_DoubleTapped"
                RightTapped="ArtistItem_RightTapped">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border
                            Width="40"
                            Height="40"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="20">
                            <Grid>
                                <FontIcon
                                    FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                                    FontSize="16"
                                    Glyph="&#xE77B;"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Image
                                    Source="{x:Bind CoverFilePath, Converter={StaticResource MusicCoverConverter}}"
                                    Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock
                                Text="{x:Bind DisplayName}"
                                FontWeight="SemiBold"
                                FontSize="13"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis">
                                <Run Text="{x:Bind SongCountText}" />
                                <Run Text="·" />
                                <Run Text="{x:Bind AlbumCountText}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <CheckBox
                        x:Name="ItemCheckBox"
                        MinWidth="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0"
                        Visibility="Collapsed"
                        Checked="ArtistItemCheckBox_Checked"
                        Unchecked="ArtistItemCheckBox_Unchecked" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MusicWaterfallItemTemplate" x:DataType="models:MediaItem">
            <Border
                Height="56"
                Padding="8,6"
                Tag="{x:Bind}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                DoubleTapped="MusicItem_DoubleTapped"
                RightTapped="MusicItem_RightTapped">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border
                            Width="36" Height="36"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="4">
                            <Image Source="{x:Bind FilePath, Converter={StaticResource MusicCoverConverter}}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" MaxLines="1" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ArtistDisplay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                    <CheckBox
                        x:Name="ItemCheckBox"
                        MinWidth="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0"
                        Visibility="Collapsed"
                        PointerPressed="MusicItemCheckBox_PointerPressed"
                        DoubleTapped="MusicItemCheckBox_DoubleTapped"
                        Checked="MusicItemCheckBox_Checked"
                        Unchecked="MusicItemCheckBox_Unchecked" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="PlaylistWaterfallItemTemplate" x:DataType="models:Playlist">
            <Border
                Height="56"
                Padding="8,6"
                Tag="{x:Bind}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                DoubleTapped="PlaylistItem_DoubleTapped"
                RightTapped="PlaylistItem_RightTapped">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
