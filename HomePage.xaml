<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SightoHear.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SightoHear"
    xmlns:models="using:SightoHear.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled"
    Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="VideoCardPointerOverBackgroundBrush" Color="#14000000"/>
                    <SolidColorBrush x:Key="VideoCardPressedBackgroundBrush" Color="#24000000"/>
                    <SolidColorBrush x:Key="VideoCardPointerOverBorderBrush" Color="#26000000"/>
                    <SolidColorBrush x:Key="HomeInteractiveCardBackgroundBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="HomeInteractiveCardPointerOverBackgroundBrush" Color="#FFF9F9F9"/>
                    <SolidColorBrush x:Key="HomeInteractiveCardPressedBackgroundBrush" Color="#FFF3F3F3"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="VideoCardPointerOverBackgroundBrush" Color="#24FFFFFF"/>
                    <SolidColorBrush x:Key="VideoCardPressedBackgroundBrush" Color="#36FFFFFF"/>
                    <SolidColorBrush x:Key="VideoCardPointerOverBorderBrush" Color="#30FFFFFF"/>
                    <!-- ★ 深色模式：初始为黑，悬停变亮，按下更亮（与浅色模式方向相反） -->
                    <SolidColorBrush x:Key="HomeInteractiveCardBackgroundBrush" Color="#FF1A1A1A"/>
                    <SolidColorBrush x:Key="HomeInteractiveCardPointerOverBackgroundBrush" Color="#FF2B2B2B"/>
                    <SolidColorBrush x:Key="HomeInteractiveCardPressedBackgroundBrush" Color="#FF3A3A3A"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <local:FilePathToImageConverter x:Key="MediaImageConverter" />

            <Style x:Key="HomeListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="HomeGridViewItemStyle" TargetType="GridViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewItem">
                            <Border x:Name="RootBorder"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Margin="0,0,8,8"
                                    Padding="8,8,8,0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="Transparent"/>
                                                <Setter Target="RootBorder.BorderBrush" Value="Transparent"/>
                                                <Setter Target="CardScale.ScaleX" Value="1"/>
                                                <Setter Target="CardScale.ScaleY" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource VideoCardPointerOverBackgroundBrush}"/>
                                                <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource VideoCardPointerOverBorderBrush}"/>
                                                <Setter Target="CardScale.ScaleX" Value="1"/>
                                                <Setter Target="CardScale.ScaleY" Value="1"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource VideoCardPressedBackgroundBrush}"/>
                                                <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource VideoCardPointerOverBorderBrush}"/>
                                                <Setter Target="CardScale.ScaleX" Value="0.985"/>
                                                <Setter Target="CardScale.ScaleY" Value="0.985"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected"/>
                                        <VisualState x:Name="SelectedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource VideoCardPointerOverBackgroundBrush}"/>
                                                <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource VideoCardPointerOverBorderBrush}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SelectedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="{ThemeResource VideoCardPressedBackgroundBrush}"/>
                                                <Setter Target="RootBorder.BorderBrush" Value="{ThemeResource VideoCardPointerOverBorderBrush}"/>
                                                <Setter Target="CardScale.ScaleX" Value="0.985"/>
                                                <Setter Target="CardScale.ScaleY" Value="0.985"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="RecentMusicTemplate" x:DataType="models:MediaItem">
                <Border
                    x:Name="RecentMusicItemCard"
                    MinHeight="64"
                    Padding="10,8"
                    Tag="{x:Bind}"
                    RightTapped="RecentMusic_RightTapped"
                    PointerEntered="RecentMusicItem_PointerEntered"
                    PointerExited="RecentMusicItem_PointerExited"
                    PointerMoved="RecentMusicItem_PointerMoved"
                    PointerPressed="RecentMusicItem_PointerPressed"
                    PointerReleased="RecentMusicItem_PointerReleased"
                    PointerCanceled="RecentMusicItem_PointerCanceled"
                    Background="{ThemeResource HomeInteractiveCardBackgroundBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="44"
                            Height="44"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="6">
                            <Grid>
                                <FontIcon
                                    FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                                    Glyph="&#xE8D6;"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Image
                                    Source="{x:Bind FilePath, Converter={StaticResource MediaImageConverter}}"
                                    Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                Text="{x:Bind Title}"
                                FontWeight="SemiBold"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{x:Bind ArtistDisplay}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind DurationText}"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="ThumbnailCardTemplate" x:DataType="models:MediaItem">
                <Border
                    Width="140"
                    Height="102"
                    Tag="{x:Bind}"
                    RightTapped="RecentThumbnail_RightTapped"
                    Background="Transparent">
                    <StackPanel Spacing="4">
                        <Border
                            Width="140"
                            Height="78"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8,8,0,0">
                            <Grid>
                                <FontIcon
                                    FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                                    FontSize="28"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Image
                                    x:Name="ThumbImage"
                                    Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <TextBlock
                            Text="{x:Bind FileName}"
                            FontSize="12"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- 音乐缩略图卡片模板（复刻视频/图片卡片样式） -->
            <DataTemplate x:Key="MusicThumbnailCardTemplate" x:DataType="models:MediaItem">
                <Border
                    Width="140"
                    Height="102"
                    Tag="{x:Bind}"
                    RightTapped="RecentMusicThumbnail_RightTapped"
                    Background="Transparent">
                    <StackPanel Spacing="4">
                        <Border
                            Width="140"
                            Height="78"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8,8,0,0">
                            <Grid>
                                <FontIcon
                                    FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                                    FontSize="28"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Image
                                    x:Name="MusicThumbImage"
                                    Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <TextBlock
                            Text="{x:Bind Title}"
                            FontSize="12"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="RootGrid" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="SidebarColumn" Width="320" />
        </Grid.ColumnDefinitions>

        <ScrollViewer
            Grid.Column="0"
            Padding="28,24,16,24"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Hidden">
            <StackPanel Spacing="20">
                <TextBlock Text="主页" Style="{StaticResource TitleTextBlockStyle}" />

                <Border
                    x:Name="HeroCard"
                    MinHeight="200"
                    MaxHeight="360"
                    Padding="0"
                    Background="{ThemeResource HomeInteractiveCardBackgroundBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Tapped="HeroCard_Tapped"
                    RightTapped="HeroCard_RightTapped"
                    PointerEntered="HeroCard_PointerEntered"
                    PointerExited="HeroCard_PointerExited"
                    PointerMoved="HeroCard_PointerMoved"
                    PointerPressed="HeroCard_PointerPressed"
                    PointerReleased="HeroCard_PointerReleased"
                    PointerCanceled="HeroCard_PointerCanceled">
                    <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="HeroImageHost" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="12,12,0,0">
                            <Grid>
                                <FontIcon
                                    x:Name="HeroPlaceholderIcon"
                                    FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                                    FontSize="48"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Image
                                    x:Name="HeroImage"
                                    Stretch="UniformToFill"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <ScaleTransform x:Name="HeroImageScale" ScaleX="1" ScaleY="1"/>
                                    </Image.RenderTransform>
                                </Image>
                            </Grid>
                        </Border>

                        <Border
                            x:Name="HeroInfoPanel"
                            Grid.Row="1"
                            Padding="18,14"
                            Background="{ThemeResource HomeInteractiveCardBackgroundBrush}"
                            CornerRadius="0,0,12,12">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="HeroTypeLabel" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="HeroTitle" FontWeight="SemiBold" FontSize="16" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="HeroSubtitle" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                    </Grid>
                </Border>

                <Border
                    x:Name="RecentVideoCard"
                    Padding="18,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="最近视频" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Button Grid.Column="1" Content="查看全部" Click="ViewAllVideosButton_Click" />
                        </Grid>
                        <GridView
                            x:Name="RecentVideoGrid"
                            IsItemClickEnabled="True"
                            ItemClick="RecentVideoGrid_ItemClick"
                            ItemContainerStyle="{StaticResource HomeGridViewItemStyle}"
                            ItemTemplate="{StaticResource ThumbnailCardTemplate}"
                            SelectionMode="None">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>
                        <TextBlock
                            x:Name="RecentVideoEmptyText"
                            Text="暂无视频"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="RecentImageCard"
                    Padding="18,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="最近图片" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Button Grid.Column="1" Content="查看全部" Click="ViewAllImagesButton_Click" />
                        </Grid>
                        <GridView
                            x:Name="RecentImageGrid"
                            IsItemClickEnabled="True"
                            ItemClick="RecentImageGrid_ItemClick"
                            ItemContainerStyle="{StaticResource HomeGridViewItemStyle}"
                            ItemTemplate="{StaticResource ThumbnailCardTemplate}"
                            SelectionMode="None">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>
                        <TextBlock
                            x:Name="RecentImageEmptyText"
                            Text="暂无图片"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- 最近音乐（窄窗口时在主内容区显示，宽窗口时隐藏，由右侧栏接管） -->
                <Border
                    x:Name="RecentMusicInlineCard"
                    Padding="18,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="最近音乐" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Button Grid.Column="1" Content="查看全部" Click="ViewAllMusicButton_Click" />
                        </Grid>
                        <GridView
                            x:Name="RecentMusicInlineGrid"
                            IsItemClickEnabled="True"
                            ItemClick="RecentMusicGrid_ItemClick"
                            ItemContainerStyle="{StaticResource HomeGridViewItemStyle}"
                            ItemTemplate="{StaticResource MusicThumbnailCardTemplate}"
                            SelectionMode="None">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>
                        <TextBlock
                            x:Name="RecentMusicInlineEmptyText"
                            Text="暂无音乐"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer
            x:Name="MusicSidebarScrollViewer"
            Grid.Column="1"
            Padding="0,24,28,24"
            HorizontalScrollMode="Disabled"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Hidden">
            <StackPanel Spacing="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="最近音乐" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Button Grid.Column="1" Content="查看全部" Click="ViewAllMusicButton_Click" />
                </Grid>
                <ListView
                    x:Name="RecentMusicList"
                    IsItemClickEnabled="True"
                    ItemClick="RecentMusicList_ItemClick"
                    ItemContainerStyle="{StaticResource HomeListViewItemStyle}"
                    ItemTemplate="{StaticResource RecentMusicTemplate}"
                    SelectionMode="None" />
                <TextBlock
                    x:Name="RecentMusicEmptyText"
                    Text="暂无音乐"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
