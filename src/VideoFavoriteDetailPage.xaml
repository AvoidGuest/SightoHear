<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SightoHear.VideoFavoriteDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SightoHear"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SightoHear.Models"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- ★ 添加视频弹窗项卡片三态颜色：
                     Light/Dark 各自独立定义，配合 ThemeResource 自动跟随实际主题，
                     替代原先在代码中基于 ActualTheme 的手动计算（Win11 弹窗中不可靠导致反色）。 -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AddItemCardNormalBackgroundBrush" Color="#FFF9F9F9"/>
                    <SolidColorBrush x:Key="AddItemCardPointerOverBackgroundBrush" Color="#FFE0E0E0"/>
                    <SolidColorBrush x:Key="AddItemCardPressedBackgroundBrush" Color="#FFCFCFCF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AddItemCardNormalBackgroundBrush" Color="#FF1F1F1F"/>
                    <SolidColorBrush x:Key="AddItemCardPointerOverBackgroundBrush" Color="#FF2E2E2E"/>
                    <SolidColorBrush x:Key="AddItemCardPressedBackgroundBrush" Color="#FF3D3D3D"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <local:FilePathToImageConverter x:Key="VideoCoverConverter" />

            <DataTemplate x:Key="AddVideoItemTemplate" x:DataType="models:AddItemOption">
                <Border
                    x:Name="CardRoot"
                    MinHeight="64"
                    Padding="10,8"
                    Background="{ThemeResource AddItemCardNormalBackgroundBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Tag="{x:Bind}"
                    Tapped="ItemCard_Tapped"
                    PointerEntered="ItemCard_PointerEntered"
                    PointerExited="ItemCard_PointerExited"
                    PointerPressed="ItemCard_PointerPressed"
                    PointerReleased="ItemCard_PointerReleased">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="44"
                            Height="44"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            CornerRadius="6">
                            <Grid>
                                <FontIcon
                                    FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE8B2;" />
                                <Image
                                    Source="{x:Bind CoverDisplayPath, Converter={StaticResource VideoCoverConverter}}"
                                    Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                FontWeight="SemiBold"
                                MaxLines="1"
                                Text="{x:Bind Item.FileName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="1"
                                Text="{x:Bind Item.DurationText}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <CheckBox
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                    </Grid>
                </Border>
            </DataTemplate>

        <Style x:Key="FavoriteVideoListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <DataTemplate x:Key="FavoriteVideoItemTemplate" x:DataType="models:MediaItem">
            <Border
                Height="64"
                Padding="12,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                DoubleTapped="VideoItem_DoubleTapped"
                RightTapped="VideoItem_RightTapped"
                Tag="{x:Bind}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>

                    <!-- 缩略图 -->
                    <Border
                        Grid.Column="0"
                        Width="40"
                        Height="40"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="4">
                        <Grid>
                            <FontIcon
                                FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                                FontSize="16"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE8B2;" />
                            <Image
                                x:Name="ThumbnailImage"
                                Source="{x:Bind ThumbnailPath, Converter={StaticResource VideoCoverConverter}}"
                                Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <!-- 文件名 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{x:Bind FileName}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- 时长 -->
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind DurationText}"
                        TextTrimming="CharacterEllipsis" />

                    <!-- 文件大小 -->
                    <TextBlock
                        Grid.Column="3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind FileSizeText}" />

                    <CheckBox
                        x:Name="ItemCheckBox"
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Checked="FavoriteVideoCheckBox_Checked"
                        Unchecked="FavoriteVideoCheckBox_Unchecked" />
                </Grid>
            </Border>
        </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24,16,24,0" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="CoverBorder"
                Width="176" Height="176"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
                <Grid>
                    <FontIcon x:Name="CoverPlaceholderIcon" FontFamily="{StaticResource SegoeFluentIconsFontFamily}" FontSize="42"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              Glyph="&#xE728;" />
                    <Image x:Name="CoverImage"
                           Stretch="UniformToFill"
                           Visibility="Collapsed" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Orientation="Horizontal" Spacing="12"
                            Margin="0,11,0,0">
                    <TextBlock x:Name="CreatedTimeText" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="VideoCountText" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <TextBlock x:Name="FavoriteNameText" Grid.Row="0" Grid.Column="0"
                           FontSize="34" FontWeight="SemiBold" MaxLines="1"
                           TextTrimming="CharacterEllipsis" Margin="-4,0,0,0" />

                <TextBlock x:Name="FavoriteDescriptionText" Grid.Row="1" Grid.ColumnSpan="2"
                           MaxLines="4" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="-1,4,0,0" />

                <Button x:Name="PlayButton" Grid.Row="3" Grid.Column="0"
                        Width="132" Height="38" Padding="20,0"
                        Click="PlayButton_Click" CornerRadius="19">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="12" Glyph="&#xE768;" />
                        <TextBlock Text="播放全部" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right"
                            Orientation="Horizontal" Spacing="8">
                    <Button x:Name="EditButton" Height="32" Padding="10,0"
                            Click="EditButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE70F;" />
                            <TextBlock Text="编辑" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AddSongsButton" Height="32" Padding="10,0"
                            Click="AddSongsButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE710;" />
                            <TextBlock Text="添加" />
                        </StackPanel>
                    </Button>
                    <ToggleButton
                        x:Name="MultiSelectToggle"
                        Height="32"
                        Padding="8,0"
                        Click="MultiSelectToggle_Click">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon FontSize="12" Glyph="&#xEA98;" />
                            <TextBlock Text="多选" />
                        </StackPanel>
                    </ToggleButton>
                    <AutoSuggestBox x:Name="VideoSearchBox" Width="320" Height="32"
                                    MinWidth="260" PlaceholderText="搜索视频" QueryIcon="Find"
                                    TextChanged="VideoSearchBox_TextChanged" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 底部区域：内容列表 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 多选工具栏 -->
            <Grid
                x:Name="MultiSelectToolbar"
                Grid.Row="0"
                Margin="24,0,2,8"
                Padding="12,8"
                ColumnSpacing="8"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    x:Name="SelectAllCheckBox"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Content="全选"
                    Click="SelectAllCheckBox_Click" />
                <TextBlock
                    x:Name="SelectedCountText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="12,0,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button
                    x:Name="MultiSelectDeleteButton"
                    Grid.Column="2"
                    Height="32"
                    Padding="8,0"
                    Click="MultiSelectDeleteButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="12" Glyph="&#xE74D;" />
                        <TextBlock Text="从收藏夹移除" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="MultiSelectPlayAllButton"
                    Grid.Column="3"
                    Height="32"
                    Padding="8,0"
                    Margin="8,0,0,0"
                    Click="MultiSelectPlayAllButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="12" Glyph="&#xE768;" />
                        <TextBlock Text="播放选中" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 列表头 -->
            <Grid
                x:Name="ListHeader"
                Grid.Row="1"
                Padding="12,8"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="封面" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="文件名" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="时长" />
                <TextBlock
                    Grid.Column="3"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="大小" />
            </Grid>

            <!-- 视频列表 -->
            <ListView
                x:Name="VideoList"
                Grid.Row="2"
                Padding="0,0,0,116"
                IsItemClickEnabled="True"
                ItemClick="VideoList_ItemClick"
                ContainerContentChanging="VideoList_ContainerContentChanging"
                ItemContainerStyle="{StaticResource FavoriteVideoListViewItemStyle}"
                ItemTemplate="{StaticResource FavoriteVideoItemTemplate}"
                SelectionMode="None">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </ListView>

            <!-- 空状态提示 -->
            <TextBlock
                x:Name="EmptyStateText"
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
