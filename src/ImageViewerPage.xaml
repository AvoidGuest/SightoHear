<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SightoHear.ImageViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SightoHear"
    xmlns:controls="using:SightoHear.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#101010"
    RequestedTheme="Dark"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <Grid x:Name="RootGrid"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Background="#101010">

        <Grid.RowDefinitions>
            <RowDefinition x:Name="ToolbarRow" Height="48"/>
            <RowDefinition x:Name="ImageRow" Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏工具栏（常驻，普通模式可见，全屏隐藏）
             右侧 Padding 138px 避免与系统窗口按钮重叠 -->
        <Grid x:Name="TitleToolbar"
              Grid.Row="0"
              Height="48"
              Background="#202020"
              HorizontalAlignment="Stretch"
              PointerPressed="TitleToolbar_PointerPressed"
              PointerMoved="TitleToolbar_PointerMoved"
              PointerReleased="TitleToolbar_PointerReleased"
              PointerCanceled="TitleToolbar_PointerCanceled"
              PointerCaptureLost="TitleToolbar_PointerCaptureLost"
              Canvas.ZIndex="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：返回 + 文件名（左列内左对齐，标题限宽防溢出） -->
            <StackPanel x:Name="LeftPanel" Grid.Column="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        Spacing="4">
                <Button x:Name="BackButton"
                        Width="36" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Click="BackButton_Click"
                        ToolTipService.ToolTip="返回">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE72B;" FontSize="14" Foreground="White"/>
                </Button>
                <TextBlock x:Name="TitleText"
                           Text="文件名"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="280"
                           Margin="4,0,8,0"/>
            </StackPanel>

            <!-- 中间：导航控件（在中间列，天然在整个标题栏水平居中） -->
            <StackPanel x:Name="CenterPanel" Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="4">
                <Button x:Name="PreviousButton"
                        Width="36" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Click="PreviousButton_Click"
                        ToolTipService.ToolTip="上一张">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE76B;" FontSize="14" Foreground="White"/>
                </Button>
                <TextBlock x:Name="IndexText"
                           Text="0/0"
                           Foreground="White"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           MinWidth="40"/>
                <Button x:Name="NextButton"
                        Width="36" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Click="NextButton_Click"
                        ToolTipService.ToolTip="下一张">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE76C;" FontSize="14" Foreground="White"/>
                </Button>
            </StackPanel>

            <!-- 右侧：工具按钮（右列内右对齐，保留右边距避免系统窗口按钮） -->
            <StackPanel x:Name="RightPanel" Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,150,0"
                        Spacing="4">

                <Button x:Name="ZoomOutButton"
                        Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Click="ZoomOutButton_Click"
                        ToolTipService.ToolTip="缩小">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE71F;" FontSize="12" Foreground="White"/>
                </Button>

                <TextBlock x:Name="ZoomText"
                           Text="适应"
                           Foreground="White"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Width="40"
                           TextAlignment="Center"/>

                <Button x:Name="ZoomInButton"
                        Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Click="ZoomInButton_Click"
                        ToolTipService.ToolTip="放大">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE8A3;" FontSize="12" Foreground="White"/>
                </Button>

                <Rectangle Width="1" Height="20" Fill="#33FFFFFF" VerticalAlignment="Center" Margin="2,0"/>

                <Button x:Name="FitButton"
                        Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Click="FitButton_Click"
                        ToolTipService.ToolTip="适应窗口">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE9A6;" FontSize="12" Foreground="White"/>
                </Button>

                <Rectangle Width="1" Height="20" Fill="#33FFFFFF" VerticalAlignment="Center" Margin="2,0"/>

                <Button x:Name="RotateLeftButton"
                        Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Click="RotateLeftButton_Click"
                        ToolTipService.ToolTip="左旋转">
                    <FontIcon x:Name="RotateLeftIcon" FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE7AD;" FontSize="12" Foreground="White" RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform>
                            <ScaleTransform ScaleX="-1"/>
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </Button>

                <Button x:Name="RotateRightButton"
                        Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Click="RotateRightButton_Click"
                        ToolTipService.ToolTip="右旋转">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE7AD;" FontSize="12" Foreground="White"/>
                </Button>

                <Rectangle Width="1" Height="20" Fill="#33FFFFFF" VerticalAlignment="Center" Margin="2,0"/>

                <Button x:Name="FullScreenButton"
                        Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Click="FullScreenButton_Click"
                        ToolTipService.ToolTip="全屏">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE740;" FontSize="12" Foreground="White"/>
                </Button>

                <Button x:Name="MoreButton"
                        Width="32" Height="32" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Click="MoreButton_Click"
                        ToolTipService.ToolTip="更多">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE712;" FontSize="12" Foreground="White"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 图片视口只负责裁剪；缩放、平移、旋转均由 Win2D 渲染管线（FreeRunCanvas，
             无垂直同步限制的自建渲染循环）在 GPU 渲染线程上完成，配合弹簧动画实现丝滑交互
             （移植自 FlyPhotos）。 -->
        <Grid x:Name="ImageViewport"
              Grid.Row="1"
              Background="#101010"
              SizeChanged="ImageViewport_SizeChanged">

            <Grid.Clip>
                <RectangleGeometry x:Name="ImageViewportClip"/>
            </Grid.Clip>

            <controls:FreeRunCanvas x:Name="ViewerCanvas"
                   Background="#FF101010"
                   ClearColor="#FF101010"
                   PointerPressed="ViewerCanvas_PointerPressed"
                   PointerMoved="ViewerCanvas_PointerMoved"
                   PointerReleased="ViewerCanvas_PointerReleased"
                   PointerCanceled="ViewerCanvas_PointerCanceled"
                   PointerCaptureLost="ViewerCanvas_PointerCaptureLost"
                   PointerWheelChanged="ViewerCanvas_PointerWheelChanged"
                   DoubleTapped="ViewerCanvas_DoubleTapped"/>
        </Grid>

        <!-- 左侧：上一张按钮（悬浮） -->
        <Button x:Name="PrevNavButton"
                Grid.Row="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Width="40" Height="40" Padding="0"
                Margin="8,0,0,0"
                Background="#33000000" BorderThickness="0"
                Opacity="0.65"
                Click="PreviousButton_Click"
                ToolTipService.ToolTip="上一张">
            <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE76B;" FontSize="14" Foreground="White"/>
        </Button>

        <!-- 右侧：下一张按钮（悬浮） -->
        <Button x:Name="NextNavButton"
                Grid.Row="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Width="40" Height="40" Padding="0"
                Margin="0,0,8,0"
                Background="#33000000" BorderThickness="0"
                Opacity="0.65"
                Click="NextButton_Click"
                ToolTipService.ToolTip="下一张">
            <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE76C;" FontSize="14" Foreground="White"/>
        </Button>
    </Grid>
</Page>
