<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SightoHear.VideoPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SightoHear"
    xmlns:mpv="using:SightoHear.Mpv.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyboardAcceleratorPlacementMode="Hidden"
    Background="Black">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="Space"
            Invoked="PlayPauseKeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush
                        x:Key="VolumeFlyoutBackgroundBrush"
                        TintColor="#F3F3F3"
                        TintOpacity="0.85"
                        TintLuminosityOpacity="0.96"
                        FallbackColor="#F3F3F3"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <AcrylicBrush
                        x:Key="VolumeFlyoutBackgroundBrush"
                        TintColor="#202020"
                        TintOpacity="0.78"
                        TintLuminosityOpacity="0.80"
                        FallbackColor="#202020"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="VolumeFlyoutPresenterStyle" TargetType="FlyoutPresenter">
                <Setter Property="Background" Value="{ThemeResource VolumeFlyoutBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="8,0,0,8"/>
            </Style>

            <!-- 与音乐播放器一致的按钮样式（搬自 MusicPlayerPage） -->
            <SolidColorBrush x:Key="PlayerControlIconBrush" Color="#FFFFFFFF"/>

            <Style x:Key="PlayerGhostButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="42"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Foreground" Value="{StaticResource PlayerControlIconBrush}"/>
            </Style>

            <Style x:Key="PlayerPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayerGhostButtonStyle}">
                <Setter Property="Width" Value="54"/>
                <Setter Property="Height" Value="54"/>
                <Setter Property="CornerRadius" Value="27"/>
                <Setter Property="Background" Value="#2BFFFFFF"/>
                <Setter Property="BorderBrush" Value="#24FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- 进度条拖动提示的时间格式化转换器 -->
            <local:SecondsToTimeConverter x:Key="SecondsToTimeConverter" />

            <!-- 播放队列项模板（参考音乐播放器，缩略图 + 文件名；当前项显示"正在播放"标记） -->
            <local:FilePathToImageConverter x:Key="FilePathToImageConverter" />

            <DataTemplate x:Key="QueueItemDefaultTemplate">
                <Border Height="56" Padding="12,6"
                        Background="{ThemeResource QueueCardBackgroundBrush}"
                        BorderBrush="{ThemeResource QueueCardBorderBrush}"
                        BorderThickness="1" CornerRadius="4"
                        PointerEntered="QueueItem_PointerEntered" PointerExited="QueueItem_PointerExited"
                        PointerPressed="QueueItem_PointerPressed" PointerReleased="QueueItem_PointerReleased"
                        PointerCanceled="QueueItem_PointerCanceled">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4">
                            <Image Source="{Binding ThumbnailPath, Converter={StaticResource FilePathToImageConverter}}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="QueueItemNowPlayingTemplate">
                <Border Height="56" Padding="12,6"
                        Background="{ThemeResource QueueCardBackgroundBrush}"
                        BorderBrush="{ThemeResource QueueCardBorderBrush}"
                        BorderThickness="1" CornerRadius="4"
                        PointerEntered="QueueItem_PointerEntered" PointerExited="QueueItem_PointerExited"
                        PointerPressed="QueueItem_PointerPressed" PointerReleased="QueueItem_PointerReleased"
                        PointerCanceled="QueueItem_PointerCanceled">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4">
                            <Image Source="{Binding ThumbnailPath, Converter={StaticResource FilePathToImageConverter}}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="正在播放" FontSize="11"
                                   Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <MediaPlayerElement
            x:Name="PlayerElement"
            AreTransportControlsEnabled="False"
            AutoPlay="True"
            Stretch="Uniform"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>

        <!-- 超分模式（libmpv）渲染宿主：仅在超分模式下显示，普通模式保持 Collapsed -->
        <mpv:RenderControl
            x:Name="MpvVideoRender"
            Visibility="Collapsed"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"/>

        <!-- 调试信息悬浮窗（类似 B 站视频详细信息）：位于播放器左上角中间区域，不贴边缘；
             半透明黑色遮罩（约 16:10），右上角叉号关闭；由右下角"更多设置"→"显示调试信息"开启；
             超分模式下轮询 mpv 属性显示分辨率/码率/帧率（原始/补帧后对比，用于监测运动补偿是否生效） -->
        <Border
            x:Name="DebugInfoPanel"
            Visibility="Collapsed"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="24,88,0,0"
            Width="280"
            Height="215"
            Background="#CC000000"
            CornerRadius="10"
            BorderBrush="#2EFFFFFF"
            BorderThickness="1"
            IsHitTestVisible="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 标题行 + 关闭叉号 -->
                <Grid Grid.Row="0" Margin="14,10,10,4">
                    <TextBlock
                        Text="调试信息"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"
                        VerticalAlignment="Center"/>
                    <Button
                        x:Name="DebugInfoCloseButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Width="24"
                        Height="24"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="12"
                        Click="DebugInfoCloseButton_Click"
                        AutomationProperties.Name="关闭调试信息"
                        ToolTipService.ToolTip="关闭">
                        <FontIcon
                            FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                            Glyph="&#xE711;"
                            FontSize="12"
                            Foreground="White"/>
                    </Button>
                </Grid>

                <!-- 详细信息行：左 label 灰色 / 右 value 白色 -->
                <StackPanel Grid.Row="1" Margin="14,0,14,10" Spacing="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="分辨率" FontSize="12" Foreground="#B3FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DebugResText" Grid.Column="1" Text="--" FontSize="12" Foreground="White" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="视频码率" FontSize="12" Foreground="#B3FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DebugBitrateText" Grid.Column="1" Text="--" FontSize="12" Foreground="White" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="音频码率" FontSize="12" Foreground="#B3FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DebugAudioBitrateText" Grid.Column="1" Text="--" FontSize="12" Foreground="White" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="帧率" FontSize="12" Foreground="#B3FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DebugFpsText" Grid.Column="1" Text="--" FontSize="12" Foreground="White" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid x:Name="DebugMcStateRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="补帧状态" FontSize="12" Foreground="#B3FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DebugMcStateText" Grid.Column="1" Text="--" FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid x:Name="DebugSrStateRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="超分状态" FontSize="12" Foreground="#B3FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DebugSrStateText" Grid.Column="1" Text="--" FontSize="12" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="编码 / 硬解" FontSize="12" Foreground="#B3FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DebugCodecText" Grid.Column="1" Text="--" FontSize="12" Foreground="White" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Rectangle
            x:Name="BottomGradient"
            VerticalAlignment="Bottom"
            Height="200"
            IsHitTestVisible="False"
            Opacity="0">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#00000000"/>
                    <GradientStop Offset="1" Color="#F2000000"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid
            x:Name="TopBar"
            VerticalAlignment="Top"
            Height="48"
            Padding="16,8,16,8"
            IsHitTestVisible="False"
            Opacity="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#CC000000"/>
                    <GradientStop Offset="1" Color="#00000000"/>
                </LinearGradientBrush>
            </Grid.Background>
            <TextBlock
                x:Name="TitleText"
                Text="视频标题"
                Foreground="White"
                FontSize="14"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis"
                Margin="48,0,0,0"/>
        </Grid>

        <Button
            x:Name="PlayerBackButton"
            Style="{StaticResource PlayerGhostButtonStyle}"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            Margin="16,6,0,0"
            Opacity="0"
            IsHitTestVisible="False"
            Click="PlayerBackButton_Click">
            <FontIcon x:Name="PlayerBackButtonIcon" FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE72B;" Foreground="White" />
        </Button>

        <Button
            x:Name="CenterPlayButton"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="80"
            Height="80"
            Background="#4DFFFFFF"
            BorderBrush="#3DFFFFFF"
            BorderThickness="1"
            CornerRadius="40"
            Opacity="0"
            IsHitTestVisible="False"
            Click="CenterPlayButton_Click">
            <FontIcon
                x:Name="CenterPlayIcon"
                FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                Glyph="&#xE768;"
                FontSize="36"
                Foreground="White"/>
        </Button>

        <Grid
            x:Name="BottomControls"
            VerticalAlignment="Bottom"
            Padding="16,0,16,16"
            Opacity="0"
            IsHitTestVisible="False">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="CurrentTimeText"
                    Grid.Column="0"
                    Text="0:00"
                    Foreground="White"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"
                    FontFamily="Segoe UI Variable"/>

                <Slider
                    x:Name="ProgressSlider"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Minimum="0"
                    Maximum="100"
                    Value="0"
                    Background="#66FFFFFF"
                    Foreground="#FF0078D4"
                    BorderThickness="0"
                    ThumbToolTipValueConverter="{StaticResource SecondsToTimeConverter}"
                    ValueChanged="ProgressSlider_ValueChanged">
                    <Slider.Resources>
                        <!-- 轨道（未推进部分）：常驻半透明白显示，悬停/按下时略微变亮提供反馈 -->
                        <SolidColorBrush x:Key="SliderTrackFill" Color="#66FFFFFF"/>
                        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#8CFFFFFF"/>
                        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#8CFFFFFF"/>
                        <!-- 已推进部分：强制统一为主题色（蓝色），任何状态都不变色 -->
                        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FF0078D4"/>
                        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FF0078D4"/>
                        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FF0078D4"/>
                    </Slider.Resources>
                </Slider>

                <TextBlock
                    x:Name="TotalTimeText"
                    Grid.Column="2"
                    Text="0:00"
                    Foreground="White"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Margin="12,0,0,0"
                    FontFamily="Segoe UI Variable"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：音量 -->
                <StackPanel
                    x:Name="LeftControls"
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Button
                        x:Name="VolumeButton"
                        Style="{StaticResource PlayerGhostButtonStyle}"
                        Click="VolumeButton_Click"
                        AutomationProperties.Name="音量"
                        ToolTipService.ToolTip="音量">
                        <Button.Flyout>
                            <Flyout
                                x:Name="VolumeFlyout"
                                Placement="Top"
                                FlyoutPresenterStyle="{StaticResource VolumeFlyoutPresenterStyle}"
                                Opened="VolumeFlyout_Opened"
                                Closed="VolumeFlyout_Closed">
                                <Grid Width="260" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        x:Name="VolumeMuteButton"
                                        Grid.Column="0"
                                        Width="34"
                                        Height="34"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="VolumeMuteButton_Click"
                                        AutomationProperties.Name="静音"
                                        ToolTipService.ToolTip="静音">
                                        <FontIcon
                                            x:Name="VolumeFlyoutIcon"
                                            Glyph="&#xE767;"
                                            FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                                            FontSize="16"/>
                                    </Button>

                                    <Slider
                                        x:Name="VolumeSlider"
                                        Grid.Column="1"
                                        MinWidth="150"
                                        VerticalAlignment="Center"
                                        Minimum="0"
                                        Maximum="100"
                                        SmallChange="1"
                                        LargeChange="10"
                                        StepFrequency="1"
                                        ValueChanged="VolumeSlider_ValueChanged"
                                        AutomationProperties.Name="音量滑块"/>

                                    <TextBlock
                                        x:Name="VolumePercentText"
                                        Grid.Column="2"
                                        Width="42"
                                        VerticalAlignment="Center"
                                        Text="100%"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        FontSize="13"
                                        TextAlignment="Right"
                                        Translation="0,-1.5,0"/>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                        <FontIcon
                            x:Name="VolumeIcon"
                            Glyph="&#xE767;"
                            FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                            FontSize="16"
                            Foreground="White"/>
                    </Button>

                    <!-- 播放速度（音量在左、速度在右、画面比例在右） -->
                    <Button
                        x:Name="SpeedButton"
                        Style="{StaticResource PlayerGhostButtonStyle}"
                        Width="48"
                        Click="SpeedButton_Click"
                        ToolTipService.ToolTip="播放速度">
                        <TextBlock
                            x:Name="SpeedText"
                            Text="1x"
                            FontSize="13"
                            Foreground="White" />
                    </Button>

                    <!-- 画面比例：弹出比例菜单（适应 / 4:3 / 16:9 / 16:10 / 21:9 / 1:1），
                         选中项为 ToggleMenuFlyoutItem，左侧显示主题色圆形选中标记 -->
                    <Button
                        x:Name="AspectRatioButton"
                        Style="{StaticResource PlayerGhostButtonStyle}"
                        Click="AspectRatioButton_Click"
                        AutomationProperties.Name="画面比例"
                        ToolTipService.ToolTip="画面比例">
                        <FontIcon
                            Glyph="&#xE799;"
                            FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                            FontSize="16"
                            Foreground="White"/>
                    </Button>

                    <!-- 画中画：点击进入 CompactOverlay 置顶小窗（16:9），可边看视频边做其他事 -->
                    <Button
                        x:Name="PictureInPictureButton"
                        Style="{StaticResource PlayerGhostButtonStyle}"
                        Click="PictureInPictureButton_Click"
                        AutomationProperties.Name="画中画"
                        ToolTipService.ToolTip="画中画">
                        <FontIcon
                            x:Name="PictureInPictureIcon"
                            Glyph="&#xE7FA;"
                            FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                            FontSize="16"
                            Foreground="White"/>
                    </Button>
                </StackPanel>

                <!-- 中间：播放控制 -->
                <StackPanel
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Canvas.ZIndex="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                    <Button
                        x:Name="PreviousButton"
                        Style="{StaticResource PlayerGhostButtonStyle}"
                        Click="PreviousButton_Click"
                        ToolTipService.ToolTip="上一个">
                        <FontIcon
                            Glyph="&#xE892;"
                            FontSize="16"
                            Foreground="White"/>
                    </Button>

                    <Button
                        x:Name="SkipBackButton"
                        Style="{StaticResource PlayerGhostButtonStyle}"
                        Click="SkipBackButton_Click"
                        ToolTipService.ToolTip="后退 10 秒">
                        <FontIcon
                            Glyph="&#xEB9E;"
                            FontSize="16"
                            Foreground="White"/>
                    </Button>

                    <Button
                        x:Name="PlayPauseButton"
                        Style="{StaticResource PlayerPrimaryButtonStyle}"
                        RequestedTheme="Dark"
                        Click="PlayPauseButton_Click"
                        ToolTipService.ToolTip="播放/暂停">
                        <FontIcon
                            x:Name="PlayPauseIcon"
                            FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                            Glyph="&#xE769;"
                            FontSize="18"/>
                    </Button>

                    <Button
                        x:Name="SkipForwardButton"
                        Style="{StaticResource PlayerGhostButtonStyle}"
                        Click="SkipForwardButton_Click"
                        ToolTipService.ToolTip="前进 10 秒">
                        <FontIcon
                            Glyph="&#xEB9D;"
                            FontSize="16"
                            Foreground="White"/>
                    </Button>

                    <Button
                        x:Name="NextButton"
                        Style="{StaticResource PlayerGhostButtonStyle}"
                        Click="NextButton_Click"
                        ToolTipService.ToolTip="下一个">
                        <FontIcon
                            Glyph="&#xE893;"
                            FontSize="16"
                            Foreground="White"/>
                    </Button>
                </StackPanel>

                <!-- 右侧：功能按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button
                        x:Name="QueueButton"
                        Style="{StaticResource PlayerGhostButtonStyle}"
                        ToolTipService.ToolTip="播放队列">
                        <FontIcon
                            FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                            FontSize="15"
                            Glyph="&#xE8FD;" />
                    </Button>
                    <Button
                        x:Name="PlayerSettingsButton"
                        Style="{StaticResource PlayerGhostButtonStyle}"
                        Click="PlayerSettingsButton_Click"
                        AutomationProperties.Name="设置"
                        ToolTipService.ToolTip="设置">
                        <FontIcon
                            FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                            FontSize="15"
                            Foreground="White"
                            Glyph="&#xE713;" />
                    </Button>
                    <Button
                        x:Name="FullScreenButton"
                        Style="{StaticResource PlayerGhostButtonStyle}"
                        Click="FullScreenButton_Click"
                        ToolTipService.ToolTip="全屏">
                        <FontIcon
                            x:Name="FullScreenIcon"
                            Glyph="&#xE740;"
                            FontSize="16"
                            Foreground="White"/>
                    </Button>

                    <Button
                        x:Name="MoreButton"
                        Style="{StaticResource PlayerGhostButtonStyle}"
                        Click="MoreButton_Click"
                        ToolTipService.ToolTip="更多选项">
                        <FontIcon
                            Glyph="&#xE712;"
                            FontSize="16"
                            Foreground="White"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 画中画（PIP）简化控制栏：窗口很小，只保留核心控件（进度条 + 播放控制），
             控件尺寸缩小；由代码在进入/退出画中画时切换显示 -->
        <Grid
            x:Name="PipControls"
            Visibility="Collapsed"
            VerticalAlignment="Bottom"
            Padding="8,0,8,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 进度条行（小字号） -->
            <Grid Grid.Row="0" Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="PipCurrentTimeText"
                    Grid.Column="0"
                    Text="0:00"
                    Foreground="White"
                    FontSize="10"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0"
                    FontFamily="Segoe UI Variable"/>
                <Slider
                    x:Name="PipProgressSlider"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Minimum="0"
                    Maximum="100"
                    Value="0"
                    Background="#66FFFFFF"
                    Foreground="#FF0078D4"
                    BorderThickness="0"
                    ThumbToolTipValueConverter="{StaticResource SecondsToTimeConverter}"
                    ValueChanged="ProgressSlider_ValueChanged">
                    <Slider.Resources>
                        <!-- 与主进度条一致的轨道/已推进颜色 -->
                        <SolidColorBrush x:Key="SliderTrackFill" Color="#66FFFFFF"/>
                        <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#8CFFFFFF"/>
                        <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#8CFFFFFF"/>
                        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FF0078D4"/>
                        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FF0078D4"/>
                        <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FF0078D4"/>
                    </Slider.Resources>
                </Slider>
                <TextBlock
                    x:Name="PipTotalTimeText"
                    Grid.Column="2"
                    Text="0:00"
                    Foreground="White"
                    FontSize="10"
                    VerticalAlignment="Center"
                    Margin="6,0,0,0"
                    FontFamily="Segoe UI Variable"/>
            </Grid>

            <!-- 核心播放控制（小尺寸按钮） -->
            <StackPanel
                Grid.Row="1"
                Orientation="Horizontal"
                Spacing="4"
                HorizontalAlignment="Center">
                <Button
                    x:Name="PipPreviousButton"
                    Style="{StaticResource PlayerGhostButtonStyle}"
                    Width="32"
                    Height="32"
                    Click="PreviousButton_Click"
                    ToolTipService.ToolTip="上一个">
                    <FontIcon
                        Glyph="&#xE892;"
                        FontSize="13"
                        Foreground="White"/>
                </Button>
                <Button
                    x:Name="PipSkipBackButton"
                    Style="{StaticResource PlayerGhostButtonStyle}"
                    Width="32"
                    Height="32"
                    Click="SkipBackButton_Click"
                    ToolTipService.ToolTip="后退 10 秒">
                    <FontIcon
                        Glyph="&#xEB9E;"
                        FontSize="13"
                        Foreground="White"/>
                </Button>
                <Button
                    x:Name="PipPlayPauseButton"
                    Style="{StaticResource PlayerPrimaryButtonStyle}"
                    Width="38"
                    Height="38"
                    CornerRadius="19"
                    RequestedTheme="Dark"
                    Click="PlayPauseButton_Click"
                    ToolTipService.ToolTip="播放/暂停">
                    <FontIcon
                        x:Name="PipPlayPauseIcon"
                        FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                        Glyph="&#xE769;"
                        FontSize="15"/>
                </Button>
                <Button
                    x:Name="PipSkipForwardButton"
                    Style="{StaticResource PlayerGhostButtonStyle}"
                    Width="32"
                    Height="32"
                    Click="SkipForwardButton_Click"
                    ToolTipService.ToolTip="前进 10 秒">
                    <FontIcon
                        Glyph="&#xEB9D;"
                        FontSize="13"
                        Foreground="White"/>
                </Button>
                <Button
                    x:Name="PipNextButton"
                    Style="{StaticResource PlayerGhostButtonStyle}"
                    Width="32"
                    Height="32"
                    Click="NextButton_Click"
                    ToolTipService.ToolTip="下一个">
                    <FontIcon
                        Glyph="&#xE893;"
                        FontSize="13"
                        Foreground="White"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
