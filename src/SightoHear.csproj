<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>SightoHear</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SightoHear.ico</ApplicationIcon>
    <Platform>x64</Platform>
    <Platforms>x64;x86;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <UseWinUI3>true</UseWinUI3>
    <WinUISDKReferences>false</WinUISDKReferences>
    <!-- 启用 VS 单项目 MSIX 打包工具链（对应 Package.appxmanifest）。
         配合 WindowsPackageType=MSIX 时，构建流程会自动：
           · 由 Package.appxmanifest 生成 AppxManifest.xml（替换 $targetnametoken$ 等占位符）
           · 注入框架依赖 PackageDependency（Microsoft.WindowsAppRuntime.2）
           · 用 makepri 生成 resources.pri
           · 按框架依赖排除 WinUI 运行时 DLL
         该开关不影响 unpackaged（WindowsPackageType=None）的日常构建。 -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- ★★ 双模式：同一个 csproj 既产出 MSIX 安装包，也产出免安装便携版。
         由 build.ps1 传入 -p:SightoHearMsix=true/false 决定，默认 MSIX（兼容旧行为）。
           · MSIX    ：WindowsPackageType=MSIX，由 build-msix 流程生成 AppxManifest + resources.pri
           · Portable：WindowsPackageType=None，直接双击 bin\<配置>\<平台>\SightoHear.exe 运行
         两者的其余差异（Bootstrap / 瘦身 / 输出目录）也都由这个开关派生，
         不需要再维护两份代码或第二个仓库。 -->
    <SightoHearMsix Condition="'$(SightoHearMsix)' == ''">true</SightoHearMsix>
    <WindowsPackageType Condition="'$(SightoHearMsix)' == 'true'">MSIX</WindowsPackageType>
    <WindowsPackageType Condition="'$(SightoHearMsix)' != 'true'">None</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <!-- ★ 根因修复：MSIX 打包必须用框架依赖（framework-dependent）部署，而非自包含。
         Windows App SDK 自包含（WindowsAppSDKSelfContained=true）仅支持 unpackaged（非打包）应用；
         打包成 MSIX 后运行时 DLL（Microsoft.UI.Xaml.dll 等）随包分发，在 packaged 激活环境下
         于托管入口（Main）之前 fail-fast 静默退出（激活成功但进程瞬间消失，无日志/无崩溃转储），
         详见 microsoft/WindowsAppSDK#2216。
         框架依赖模式下：
           · 运行时 DLL 不再复制到输出目录（构建时自动排除），
           · 通过 Package.appxmanifest 的 <PackageDependency Name="Microsoft.WindowsAppRuntime.2"/> 声明，
           · 由系统框架包（Windows App Runtime 2.x，本机已装 2.3.1）提供运行时，
           · 启动时经 Bootstrap auto-initializer（模块初始化器）在 Main 之前自动 MddBootstrapInitialize 加载。
         注意：SelfContained=true（.NET 自包含，CoreCLR 随包分发）与 WinUI 框架依赖互不冲突，保持不变。 -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <!-- ★ 根因修复（MSIX 正式安装崩溃）：禁用 DeploymentManager auto-initializer。
         Windows App SDK 1.8+ 默认启用 DeploymentManager auto-initializer，它在 Main 之前的
         模块初始化器中调用 DeploymentManager.Initialize，用于加载 Main/Singleton 包（推送通知、
         AppNotificationManager 等功能）。本应用不使用这些功能，但该初始化器在 Windows 10 上
         尝试激活 DeploymentInitializeOptions 类失败（0x80040154 REGDB_E_CLASSNOTREG），
         导致进程在模块初始化器阶段崩溃（e0434352，Main 永不执行）。
         详见 microsoft/WindowsAppSDK#3137、#6117。禁用后由 Framework 包的 PackageDependency
         声明正常加载运行时，不影响 WinUI 3 / AppLifecycle / MRT Core 等核心功能。 -->
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <!-- ★★ Bootstrap 的开关条件有三个，缺一不可（这条是踩崩过的，改动前务必读完）：
         1) 必须区分 WindowsPackageType：
              · MSIX（打包）      → Bootstrap 必须【关闭】。打包应用由 AppxManifest 的
                                    PackageDependency 获得 Windows App Runtime，进程本身已有包标识；
                                    再调 MddBootstrapInitialize 会在 Main 之前失败，表现为
                                    「安装成功、双击无反应、进程瞬间消失」。
              · Portable（非打包）→ Bootstrap 必须【开启】，由它去找机器上已安装的运行时；
                                    关掉会在 Main 之前 COMException(E_NOINTERFACE) 崩溃。
         2) 必须跟随 WindowsAppSDKSelfContained 反转：
              · SelfContained=true  → 运行时 DLL 就在输出目录，Bootstrap 会去抢注「已安装的」运行时，
                                      版本不匹配时直接 0xC0000409，必须关闭。
              · SelfContained=false → 保留上面 1) 的结论。
         3) 不写时 SDK 的默认值是「仅 WindowsPackageType==None 才自动开启」
            （见 Microsoft.WindowsAppSDK.BootstrapCommon.targets），
            本意与 1) 一致，但一旦显式赋值就会覆盖该默认行为，所以这里必须把
            WindowsPackageType 写进条件，不能只判断 SelfContained。

         ★ 2026-11-15 回归事故：曾只按 SelfContained 判断（两种模式都是 false →
           统一置 true），导致 MSIX 包带上 Bootstrap，安装后无法启动。
           修复即下面这两行 —— 加回 WindowsPackageType 条件。 -->
    <WindowsAppSdkBootstrapInitialize Condition="'$(WindowsPackageType)' == 'None' and '$(WindowsAppSDKSelfContained)' != 'true'">true</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkBootstrapInitialize Condition="'$(WindowsPackageType)' != 'None' or '$(WindowsAppSDKSelfContained)' == 'true'">false</WindowsAppSdkBootstrapInitialize>
    <!-- 使用自定义 Program.Main（App.xaml.cs 中定义）替代 XAML 生成的 Main，
         便于打包启动诊断与异常捕获（配合 DISABLE_XAML_GENERATED_MAIN）。
         注意：框架依赖模式依赖 Bootstrap auto-initializer，因此【不能】再设
         WindowsAppSdkBootstrapInitialize=false（那会禁用自动初始化，导致框架包运行时无法加载）。 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- ★ 已删除 <WindowsXamlAot>：该属性在 Windows App SDK 2.3.1 / WinUI 2.3.0 的
         targets 与 props 中完全不存在（全 NuGet 缓存搜索无结果），设成 false 或 true
         都不会产生任何效果，只是历史遗留的噪音配置。 -->
    <WindowsXamlLocalAssembly>SightoHear</WindowsXamlLocalAssembly>
    <NoWarn>CA1416</NoWarn>
    <!-- 本机未安装 Windows SDK，cswinrt 无法从注册表定位 SDK 元数据；
         显式指向 NuGet 缓存中 Microsoft.Windows.SDK.NET.Ref 10.0.26100.57 的 winmd 目录，
         供 FFmpegInteropX 2.1.0 的 CsWinRT 投影生成使用。 -->
    <CsWinRTWindowsMetadata>$(NuGetPackageRoot)microsoft.windows.sdk.net.ref\10.0.26100.57\winmd</CsWinRTWindowsMetadata>

    <!-- ==================== Native AOT（.NET 10）====================
         publish 时用 ILCompiler 把 IL 直接编译成本机代码，产物无 JIT，收益实测：
           · 启动到首帧窗口：约 1950ms → 约 1040ms（约 -47%）
           · 分发体积（不含 pdb）：约 503MB → 约 332MB（-34%）
           · 常驻内存：约 231MB → 约 150MB（-35%）
         注意：AOT 只在 `dotnet publish` 时生效，`dotnet build` 仍产出普通托管程序（便于 F5 调试）。

         ★ MSIX 打包注意：AOT 与 MSIX 打包的组合尚未在本项目验证。
           打包流程走 build-msix.ps1（dotnet publish → makeappx → 签名），
           若开启 PublishAot，产物是本机 exe，AppxManifest/资源布局需另行验证。

         两项配套开关不可省：
           · CsWinRT AOT 优化器：Windows App SDK 要求显式置 true 才支持 PublishAot
             （否则构建报 "requires CsWinRTAotOptimizerEnabled set to true"）。
           · 运行时开关见下方 Publish Properties：PublishTrimmed 由 AOT 隐含，不能显式关闭。 -->
    <PublishAot Condition="'$(PublishAot)' == '' and '$(Configuration)' != 'Debug'">true</PublishAot>
    <CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
    <!-- CsWinRT 的 AOT 分析器级别（0=关，1=默认，2=同时检查内建 WinRT 映射类型）。
         Level 1 只是为避免噪声的默认值，Level 2 才是应当启用并逐条评估的级别。 -->
    <CsWinRTAotWarningLevel Condition="'$(PublishAot)' == 'true'">2</CsWinRTAotWarningLevel>
    <!-- ★ 体积优化：实测 SightoHear.exe 由 37.0MB 降至 29.6MB（-20%）。
         原理：ILCompiler 改传优化代码尺寸的开关，而不是优化执行速度的开关。
         只影响 AOT 生成的本机代码，对 libmpv / ONNX / DirectML 等原生 DLL 无效果。
         需要改回速度优先时：dotnet publish -c Release -p:OptimizationPreference=Speed -->
    <OptimizationPreference Condition="'$(PublishAot)' == 'true'">Size</OptimizationPreference>
    <!-- ★ AOT 审计（默认关闭）：开启后编译器会把所有 Trim/AOT 兼容性警告全量打印。
         实测本项目会产生 90 条 IL3058 + 49 条 IL3050 + 31 条 IL2070 等约 250 条，
         其中绝大多数来自第三方 WinRT 投影程序集与 CommunityToolkit / Newtonsoft，
         无法在本项目内修复。只在需要重新评估依赖时手动开启：-p:AotAudit=true
         注意 VerifyReferenceAotCompatibility 依赖 .NET 10 引入的程序集级 IsAotCompatible
         元数据；旧版编译的库即使 AOT 下实际可用，也会因缺少该标记而被报 IL3058。 -->
    <IsAotCompatible Condition="'$(AotAudit)' == 'true'">true</IsAotCompatible>
    <EnableAotAnalyzer Condition="'$(AotAudit)' == 'true'">true</EnableAotAnalyzer>
    <EnableTrimAnalyzer Condition="'$(AotAudit)' == 'true'">true</EnableTrimAnalyzer>
    <VerifyReferenceAotCompatibility Condition="'$(AotAudit)' == 'true'">true</VerifyReferenceAotCompatibility>
    <TrimmerSingleWarn Condition="'$(AotAudit)' == 'true'">false</TrimmerSingleWarn>
    <!-- AOT 产物默认生成同名 .pdb（本项目约 164MB，纯调试符号，运行时完全不需要）。
         build.ps1 默认把它移到 bin\Symbols\ 并重命名带版本号，不随可运行目录分发。 -->
    <StripSymbols>false</StripSymbols>
    <!-- ★ 注意：不要设置 <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>。
         Native AOT 默认已关闭反射式 JSON，本项目已全面改用源生成（Services/AppJsonContext.cs）。
         实测把该属性显式写 false 会破坏 Windows App SDK 自身的启动路径
         （Microsoft.UI.Xaml.dll 在 Application.Start 阶段崩溃 0xC000027B），切勿加回。 -->
  </PropertyGroup>

  <!-- ==================== 版本号（单一事实来源） ====================
       升级版本时只需修改此处的 <Version>，程序集/文件版本、关于页显示、
       MSIX 包版本（Package.appxmanifest 需手动同步 Identity.Version）随之联动。
       - 测试阶段：0.3.0-beta（MSIX 四段版本 0.3.0.0）
       - 正式版：1.0.0（MSIX 四段版本 1.0.0.0）
       MSIX 注意：同一应用只能升不能降，测试期每次打包必须递增版本号。
       AssemblyVersion/FileVersion 必须是纯数字四段（a.b.c.d，0~65535）。 -->
  <PropertyGroup>
    <Version>0.4.0</Version>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <FileVersion>0.4.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <!-- 图标字体（Fluent System Icons / Segoe Fluent Icons / Font Awesome）：
         必须设置 CopyToOutputDirectory，否则 dotnet build 输出目录不包含字体文件，
         build-msix.ps1 打包 MSIX 时漏掉字体，运行时 ms-appx:///Assets/Fonts/* 解析失败，
         图标（FontIcon 字形）显示为方框/括号。 -->
    <Content Include="Assets\Fonts\*.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\Fonts\*.otf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\SightoHear.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\SightoHear.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- 关于页开发者头像与开源致谢图标（AboutPage.xaml 以 Assets/xxx 相对路径引用，
         需复制到输出目录，否则 MSIX 打包后图片缺失） -->
    <Content Include="Assets\AvoidGuest.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\BetterLyricsLogo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- Anime4K 超分 shader（超分模式 libmpv 直接加载，原样分发） -->
    <Content Include="Assets\Anime4K\*.glsl">
      <Link>Assets\Anime4K\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- 运动补偿（MVTools/SVPFlow）VapourSynth 脚本（超分模式 libmpv 通过 vf vapoursynth 滤镜加载） -->
    <Content Include="Assets\Mpv\VS\*.vpy">
      <Link>Assets\Mpv\VS\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- VapourSynth 运行时由 CopyVapourSynthRuntime Target 复制到输出根目录，
         排除默认 Content 避免被 WinUI 资源系统（PRI）扫描（vapoursynth.cp312-win_amd64.pyd
         等文件名被误解析为资源限定符触发 PRI249 警告，且 Target 复制与其复制路径冲突） -->
    <Content Remove="Assets\Mpv\VapourSynth\**" />
    <None Remove="Assets\Mpv\VapourSynth\**" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.ColorPicker" Version="8.2.251219" />
    <!-- ★ 已移除 CommunityToolkit.WinUI.UI.Controls 7.1.2：
         该版本是 WinUI 3 早期的 Toolkit，其 XamlTypeInfo 使用旧式反射元数据提供器
         （AOT 审计报 IL2059: XamlUserType.RunInitializer），且明确未声明 IsAotCompatible。
         实测本项目 XAML/代码中没有任何 `CommunityToolkit.WinUI.UI.*` 引用
         （所有 xmlns 均为 8.x 的 CommunityToolkit.WinUI[.Controls]），
         保留它只会让旧式 XAML 元数据参与程序集扫描，干扰 AOT 下的类型解析。
         若将来需要 DataGrid/Markdown 等 7.1.2 独有控件，请优先找 8.x 替代品。 -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="ComputeSharp" Version="3.2.0" />
    <PackageReference Include="ComputeSharp.D2D1" Version="3.2.0" />
    <PackageReference Include="FFmpegInteropX" Version="2.1.0.81200" />
    <PackageReference Include="Lyricify.Lyrics.Helper" Version="0.1.4" />
    <PackageReference Include="ComputeSharp.D2D1.WinUI" Version="3.2.0" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1721" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.VCRTForwarders.140" Version="1.1.0" ExcludeAssets="all" />
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="Serilog" Version="4.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="SkiaSharp.Views.WinUI" Version="3.116.1" />
    <!-- libmpv 视频播放内核（超分模式）：OpenGL 渲染 + D3D11 互操作 -->
    <PackageReference Include="OpenTK" Version="4.8.2" />
    <PackageReference Include="Silk.NET.Direct3D11" Version="2.21.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.21.0" />
    <PackageReference Include="Endpne.LibMPV.Windows" Version="0.41.0" />
    <!-- 崩溃日志增强：读取 Windows 事件日志（EventLogQuery/EventLogReader）用于启动时崩溃自检 -->
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(Platform)' == 'x86' or '$(Platform)' == 'x64' or '$(Platform)' == 'ARM64'">
    <!-- FFmpegInteropX v2.1.0 的 targets 已自动复制 FFmpegInteropX.dll 与 FFmpeg 原生库（ReferenceCopyLocalPaths），无需手动 Content。
         仅保留 VCRTForwarders（旧版 FFmpeg 运行库兼容）。 -->
    <Content Include="$(NuGetPackageRoot)microsoft.vcrtforwarders.140\1.1.0\runtimes\win-$(Platform)\native\release\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- libmpv 原生库：Endpne.LibMPV.Windows 的 targets 只复制 .lib 而漏掉 libmpv-2.dll，这里显式复制（按平台） -->
  <ItemGroup Condition="'$(Platform)' == 'x64'">
    <Content Include="$(NuGetPackageRoot)endpne.libmpv.windows\0.41.0\build\x64\libmpv-2.dll">
      <Link>libmpv\win-x64\libmpv-2.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="'$(Platform)' == 'ARM64'">
    <Content Include="$(NuGetPackageRoot)endpne.libmpv.windows\0.41.0\build\arm64\libmpv-2.dll">
      <Link>libmpv\win-arm64\libmpv-2.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug' and '$(PublishAot)' != 'true'">True</PublishReadyToRun>
    <!-- Native AOT 隐含 PublishTrimmed=true，显式写 False 会被 ILCompiler 拒绝；仅在非 AOT 时关闭裁剪。 -->
    <PublishTrimmed Condition="'$(PublishAot)' != 'true'">False</PublishTrimmed>
  </PropertyGroup>

  <!-- ★★ 快速增量编译通道（build.ps1 -Target Fast）
       WinUI 的 MarkupCompilePass1 / MarkupCompilePass2 / XamlPreCompile 在
       Microsoft.UI.Xaml.Markup.Compiler.interop.targets 里【没有定义 Inputs/Outputs】，
       MSBuild 因此永远无法判定它们可跳过 —— 实测连「什么都不改」的空构建都要 31 秒，
       其中 30.5 秒全花在把 28 个 XAML 页原样重编一遍上（目标耗时：Pass2 20.9s +
       XamlPreCompile 5.1s + Pass1 4.5s，而真正的 Csc 只有 5.1s）。

       绕过办法：用 `-t:Compile` 只跑 C# 编译，再把上一次 Pass1/Pass2 生成的
       *.g.cs / *.g.i.cs 重新链进编译。这两类文件内容没变就无需重生成：
         · *.g.i.cs → InitializeComponent()、控件字段、IBinding 接口定义
         · *.g.cs   → x:Bind 的强类型绑定实现
       实测 37 秒 → 7 秒。

       ★ 仅在显式传入 -p:XamlFastPath=true 时生效，正常构建完全不受影响。
       ★ build.ps1 会先校验「.xaml 没有比生成代码更新」，不满足就回退完整构建，
         所以这条通道不会产出与实际 XAML 不一致的 dll。 -->
  <ItemGroup Condition="'$(XamlFastPath)' == 'true'">
    <Compile Include="$(IntermediateOutputPath)*.g.cs" />
    <Compile Include="$(IntermediateOutputPath)*.g.i.cs" />
  </ItemGroup>

  <!-- 关键修复：SkiaSharp.NativeAssets.WinUI 传递引入的 ANGLE（libEGL.dll + libGLESv2.dll，OpenGL ES 实现）
       会与 libmpv 的桌面 OpenGL 渲染上下文冲突，导致超分模式 mpv_render_context_create 阶段
       AccessViolationException 崩溃（0xC0000005，经 Demo 判别实验确认根因）。
       本项目 SkiaSharp 仅用于 CPU 光栅化（封面/缩略图/裁剪），不使用 SKXamlCanvas GL 表面，
       ANGLE 纯冗余，故从输出中移除；SkiaSharp.Views.WinUI.Native.* 为 WinUI 绑定核心，必须保留。

       ★ 必须同时对 $(TargetDir) 与 $(PublishDir) 生效：
         发布流程（build-msix.ps1 / build.ps1 -Aot）是「发布到另一目录 → 再拷进 bin」，
         只处理 TargetDir 会让最终那份额外残留 ANGLE，超分模式崩 0xC0000005。 -->
  <Target Name="RemoveSkiaSharpAngleNativeLibs" AfterTargets="Build;Publish">
    <PropertyGroup>
      <_PublishDirSlash>$(PublishDir)</_PublishDirSlash>
      <_PublishDirSlash Condition="'$(_PublishDirSlash)' != '' and !HasTrailingSlash('$(_PublishDirSlash)')">$(_PublishDirSlash)\</_PublishDirSlash>
    </PropertyGroup>
    <ItemGroup>
      <_AngleNativeDlls Include="$(TargetDir)libEGL.dll;$(TargetDir)libGLESv2.dll" />
      <_AngleNativeDlls Include="$(_PublishDirSlash)libEGL.dll;$(_PublishDirSlash)libGLESv2.dll"
                        Condition="'$(_PublishDirSlash)' != ''" />
    </ItemGroup>
    <Delete Files="@(_AngleNativeDlls)" />
  </Target>

  <!-- x86 平台不支持 libmpv（Endpne.LibMPV.Windows 仅提供 x64/ARM64 dll）：
       构建时给出警告；运行时由 VideoSettingsPage / VideoPlayerPage / App 启动逻辑兜底回退普通模式 -->
  <Target Name="WarnMpvUnsupportedOnX86" BeforeTargets="Build" Condition="'$(Platform)' == 'x86'">
    <Warning Text="x86（32 位）平台不支持 libmpv 超分模式：本次构建将自动使用普通模式。超分模式（Anime4K 实时超分）仅支持 x64/ARM64。" />
  </Target>

  <!-- 运动补偿（MVTools/SVPFlow）VapourSynth 便携式运行时复制：
       布局要求（见 VapourSynth vscore.cpp isPortableInit）：
         · VSScript.dll / python312.dll / _pth / _ctypes.pyd 等必须与 exe 同级（DLL 搜索路径）
         · portable.vs 标记便携模式，其目录下的 vs-coreplugins/ 与 vs-plugins/ 为插件加载路径
         · Lib\site-packages\ 下 vapoursynth.dll（vapoursynth.dll 向上 2 级查找 portable.vs）
       因此整个 Assets\Mpv\VapourSynth 目录按原样复制到输出根目录（与 SightoHear.exe 同级）。
       仅 x64 平台复制：VapourSynth 便携运行时与 MVTools/SVPFlow 插件均为 x64 二进制，
       ARM64 平台（进程原生 ARM64）无法加载，运行时由代码层禁用运动补偿。 -->
  <Target Name="CopyVapourSynthRuntime" AfterTargets="Build;Publish" Condition="'$(Platform)' == 'x64'">
    <PropertyGroup>
      <_VsPublishDirSlash>$(PublishDir)</_VsPublishDirSlash>
      <_VsPublishDirSlash Condition="'$(_VsPublishDirSlash)' != '' and !HasTrailingSlash('$(_VsPublishDirSlash)')">$(_VsPublishDirSlash)\</_VsPublishDirSlash>
    </PropertyGroup>
    <ItemGroup>
      <_VsRuntimeFiles Include="Assets\Mpv\VapourSynth\**\*" />
    </ItemGroup>
    <!-- 构建输出（bin\...） -->
    <Copy SourceFiles="@(_VsRuntimeFiles)"
          DestinationFiles="@(_VsRuntimeFiles->'$(TargetDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <!-- ★ 发布输出：发布到 staging 后再拷进 bin 的流程里，
         若不复制到这里，最终包的根目录会缺 VSScript.dll / python312 等，
         导致超分模式的「运动补偿补帧」整段失效。 -->
    <Copy SourceFiles="@(_VsRuntimeFiles)"
          DestinationFiles="@(_VsRuntimeFiles->'$(_VsPublishDirSlash)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'$(_VsPublishDirSlash)' != ''" />
  </Target>

  <!-- ==================== 分发目录瘦身（SlimDistributionOutput）====================
       目标：让输出目录里能一眼找到 SightoHear.exe，而不是淹在几百个文件里。
       实测（x64 Release AOT，非打包）：365 个文件 / 343.7 MB → 119 个文件 / 332.4 MB。

       ★ 每一条都做过「删除后实际运行 + 遍历所有页面 + 播放视频」验证：

       1) *.winmd（52 个）        Windows Runtime 元数据，只供编译期生成投影用，运行时不读。
       2) *.lib（8 个）           FFmpeg/libmpv 的导入库，只供链接期使用，运行时只需要 .dll。
       3) 语言目录（76 → 5）      Windows App SDK / WinUI 自带的 .mui 本地化错误串。
                                  本项目自身没有任何 .resw 本地化资源，界面文案全部硬编码中文。
                                  只保留 zh-CN / zh-TW / en-us / en-GB / ja-JP。
       4) Microsoft.Windows.AI.*（6 个）+ Microsoft.Windows.Workloads.*（4 个）
                                  Windows App SDK 的可选 AI / 工作负载组件。本项目用
                                  ONNX Runtime + DirectML 自己做超分，从不实例化这些 WinRT 类型。
       5) workloads.*.json（6 个）同上的配置清单。
       6) NPUDetect / WebView2Loader / RestartAgent.exe / Microsoft.UI.Designer.dll
                                  SDK 附带的工具型二进制，本项目不调用。
       7) 后台任务/推送/会话 IPC 的 ProxyStub 3 个：非打包应用不用。

       ★ MSIX 打包模式下不执行本目标（-p:SightoHearMsix=true 时跳过，见 Condition）：
         AppxManifest 的 PackageDependency、.winmd、语言资源都参与 makeappx 打包与
         resources.pri 生成，在【构建输出目录】里删掉会破坏打包或安装后缺资源。

         ★ 包内瘦身改在 build-msix.ps1 里做：等 resources.pri 与 AppxManifest.xml 都生成完毕、
           只差 MakeAppx 这一步时，再对 payload 目录剔除运行期不需要的文件
           （*.winmd / *.lib / *_app.dll / mscordac* / mscordbi* / DiaSymReader /
            Microsoft.Windows.AI.* / 工具型 exe / ProxyStub 等）。
           实机验证：401 → 367 个文件，137.1 → 133.8 MB，安装后启动与全部页面正常。
           需要排查时可加 build-msix.ps1 -SkipPayloadSlim 跳过。

       ★ 绝对不能删（删了就起不来 / 功能失效，均已实测）：
         WinUIEdit.dll              XAML 编辑/输入核心，删掉进程直接起不来。
         Microsoft.UI.Xaml.Internal.dll、Microsoft.ui.xaml.resources.*.dll
         Microsoft.UI.Xaml.Phone.dll
         libmpv-2.dll、onnxruntime.dll、DirectML.dll、python312*、VSScript.dll
         Microsoft.Graphics.Canvas.dll（Win2D）、libSkiaSharp.dll、FFmpegInteropX.dll -->
  <Target Name="SlimDistributionOutput" AfterTargets="Build;Publish"
          Condition="'$(SightoHearMsix)' != 'true'">
    <!-- PublishDir 在 Build 阶段可能为空，此时只处理 TargetDir -->
    <PropertyGroup>
      <_SlimPublishDir>$(PublishDir)</_SlimPublishDir>
      <_SlimPublishDir Condition="'$(_SlimPublishDir)' != '' and !HasTrailingSlash('$(_SlimPublishDir)')">$(_SlimPublishDir)\</_SlimPublishDir>
    </PropertyGroup>

    <!-- ① 元数据 / 链接期文件（递归，覆盖 libmpv\win-x64\libmpv.lib 这类子目录里的 .lib） -->
    <ItemGroup>
      <_SlimMetadataFiles Include="$(TargetDir)**\*.winmd;$(TargetDir)**\*.lib" />
      <_SlimMetadataFiles Include="$(_SlimPublishDir)**\*.winmd;$(_SlimPublishDir)**\*.lib"
                          Condition="'$(_SlimPublishDir)' != ''" />
    </ItemGroup>
    <Delete Files="@(_SlimMetadataFiles)" />

    <!-- ② 非必需的可选组件（按确切文件名，不用通配符，避免误删同名新依赖） -->
    <ItemGroup>
      <_SlimOptionalNames Include="Microsoft.Windows.AI.AICapabilities.dll" />
      <_SlimOptionalNames Include="Microsoft.Windows.AI.ContentSafety.dll" />
      <_SlimOptionalNames Include="Microsoft.Windows.AI.Imaging.dll" />
      <_SlimOptionalNames Include="Microsoft.Windows.AI.MachineLearning.dll" />
      <_SlimOptionalNames Include="Microsoft.Windows.AI.Text.dll" />
      <_SlimOptionalNames Include="Microsoft.Windows.AI.Video.dll" />
      <_SlimOptionalNames Include="Microsoft.Windows.Workloads.dll" />
      <_SlimOptionalNames Include="Microsoft.Windows.Workloads.pri" />
      <_SlimOptionalNames Include="Microsoft.Windows.Workloads.Resources.dll" />
      <_SlimOptionalNames Include="Microsoft.Windows.Workloads.Resources_ec.dll" />
      <_SlimOptionalNames Include="NPUDetect.dll" />
      <_SlimOptionalNames Include="WebView2Loader.dll" />
      <_SlimOptionalNames Include="RestartAgent.exe" />
      <_SlimOptionalNames Include="Microsoft.UI.Designer.dll" />
      <_SlimOptionalNames Include="Microsoft.Windows.ApplicationModel.Background.UniversalBGTask.dll" />
      <_SlimOptionalNames Include="PushNotificationsLongRunningTask.ProxyStub.dll" />
      <_SlimOptionalNames Include="SessionHandleIPCProxyStub.dll" />
      <_SlimOptionalNames Include="workloads.365.json" />
      <_SlimOptionalNames Include="workloads.j32.json" />
      <_SlimOptionalNames Include="workloads.json" />
      <_SlimOptionalNames Include="workloads.lnl.json" />
      <_SlimOptionalNames Include="workloads.qnn.json" />
      <_SlimOptionalNames Include="workloads.stx.json" />
    </ItemGroup>
    <ItemGroup>
      <_SlimOptionalFiles Include="@(_SlimOptionalNames->'$(TargetDir)%(Identity)')" />
      <_SlimOptionalFiles Include="@(_SlimOptionalNames->'$(_SlimPublishDir)%(Identity)')"
                          Condition="'$(_SlimPublishDir)' != ''" />
    </ItemGroup>

    <!-- ★ VCRT 转发桩（*_app.dll）：Microsoft.VCRTForwarders.140 只为「把 API Set 转发到
         VC++ 运行库」而存在。本项目全部原生依赖（FFmpeg / libmpv / SkiaSharp / Win2D /
         WindowsAppSDK）都吃 Windows 自带的 UCRT，无人引用这 10 个桩。
         验证方式：把输出目录全部 DLL 读成字节流扫描导入表，
         除它们自身互相引用外没有任何命中；删掉后启动 + 遍历页面均正常。 -->
    <ItemGroup>
      <_SlimVcrtForwarders Include="$(TargetDir)*_app.dll" />
      <_SlimVcrtForwarders Include="$(_SlimPublishDir)*_app.dll"
                           Condition="'$(_SlimPublishDir)' != ''" />
    </ItemGroup>
    <Delete Files="@(_SlimVcrtForwarders)" />

    <!-- ★ Bootstrap 只在「自带 WinAppSDK 运行时」时才是冗余的；
         框架依赖模式（本项目两种发布模式的默认）下它是启动链的第一步，删掉进程直接 0xC0000409。 -->
    <ItemGroup Condition="'$(WindowsAppSDKSelfContained)' == 'true'">
      <_SlimBootstrap Include="$(TargetDir)Microsoft.WindowsAppRuntime.Bootstrap.dll" />
      <_SlimBootstrap Include="$(_SlimPublishDir)Microsoft.WindowsAppRuntime.Bootstrap.dll"
                      Condition="'$(_SlimPublishDir)' != ''" />
    </ItemGroup>
    <Delete Files="@(_SlimBootstrap)" />

    <Delete Files="@(_SlimOptionalFiles)" />

    <!-- ③ 语言目录：只保留 5 个，其余按目录名精确删除。
           ★ 判定用「形状 + 排除名单」双保险，不靠单一正则：
             形状：以 2~3 位小写字母开头（ISO 639-1 或 639-3，如 fil-PH / quz-PE），
                   后面跟 1~2 段 -XX（xx-YY / xx-Script-YY）
             排除：把项目里所有非语言的、且恰好符合该形状的目录显式列出来。
             踩过的坑：
               · 写成 ^[a-zA-Z]{2}(-[a-zA-Z]+)?$ 会漏掉三段式 az-Latn-AZ / sr-Cyrl-RS（11 个）；
               · 放宽成 ^[a-zA-Z]{2,3}(-[a-zA-Z]+){0,2}$ 会误匹配 vs-plugins、Lib ——
                 Lib\site-packages 是 VapourSynth 运行时、vs-plugins 是补帧插件，删了功能直接失效。
           注意：MSBuild 属性函数里不能用 LINQ，改用字符串拼接后 Contains 判断；
                 项批量转换里不能写 %(_Item.Identity)，直接写 %(Identity)。 -->
    <PropertyGroup>
      <_LangDirPattern>^[a-z]{2,3}(-[A-Za-z]{2,8}){1,2}$</_LangDirPattern>
      <_KeepLangList>;zh-CN;zh-TW;en-us;en-GB;ja-JP;</_KeepLangList>
      <_NonLangDirList>;Assets;Lib;libmpv;vs-plugins;vs-coreplugins;Microsoft.UI.Xaml;</_NonLangDirList>
    </PropertyGroup>
    <ItemGroup>
      <_AllLangDirs Include="$([System.IO.Directory]::GetDirectories('$(TargetDir)'))"
                    Condition="Exists('$(TargetDir)')" />
      <_AllLangDirs Include="$([System.IO.Directory]::GetDirectories('$(_SlimPublishDir)'))"
                    Condition="'$(_SlimPublishDir)' != '' and Exists('$(_SlimPublishDir)')" />
    </ItemGroup>
    <ItemGroup>
      <_LangDirsToRemove Include="@(_AllLangDirs)"
                         Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '$(_LangDirPattern)')) and !$(_KeepLangList.Contains(';%(Filename);')) and !$(_NonLangDirList.Contains(';%(Filename);'))" />
    </ItemGroup>
    <RemoveDir Directories="@(_LangDirsToRemove)" />
  </Target>
</Project>
