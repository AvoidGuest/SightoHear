<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SightoHear.PlaylistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SightoHear"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SightoHear.Models"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <local:FilePathToImageConverter x:Key="MusicCoverConverter" />

        <Style x:Key="PlaylistSongListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="24,0,0,4" />
        </Style>

        <DataTemplate x:Key="PlaylistSongItemTemplate" x:DataType="models:MediaItem">
            <Border
                Height="64"
                Padding="12,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                DoubleTapped="SongItem_DoubleTapped"
                RightTapped="SongItem_RightTapped"
                Tag="{x:Bind}">
                <Grid x:Name="SongItemGrid" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="AlbumColumn" Width="220" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="40"
                        Height="40"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="4">
                        <Grid>
                            <FontIcon
                                FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE8D6;" />
                            <Image
                                Source="{x:Bind FilePath, Converter={StaticResource MusicCoverConverter}}"
                                Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ArtistDisplay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock
                        x:Name="AlbumText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind AlbumDisplay}"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        Grid.Column="3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind DurationText}" />

                    <CheckBox
                        x:Name="ItemCheckBox"
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Checked="PlaylistSongCheckBox_Checked"
                        Unchecked="PlaylistSongCheckBox_Unchecked" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AddSongItemTemplate" x:DataType="local:AddSongOption">
            <Border
                MinHeight="64"
                Padding="10,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Tag="{x:Bind}"
                Tapped="AddSongCard_Tapped">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="44"
                        Height="44"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="6">
                        <Grid>
                            <FontIcon
                                FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE8D6;" />
                            <Image
                                Source="{x:Bind Item.FilePath, Converter={StaticResource MusicCoverConverter}}"
                                Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontWeight="SemiBold"
                            MaxLines="1"
                            Text="{x:Bind Item.Title}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="1"
                            Text="{x:Bind Item.ArtistDisplay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <CheckBox
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="0,16,0,0" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 宽窗口布局（≥900px） ==================== -->
        <!-- 操作按钮和搜索框在同一行靠右 -->
        <Grid
            x:Name="WideHeaderLayout"
            Grid.Row="0"
            ColumnSpacing="24"
            Padding="24,0"
            Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="WideCoverBorder"
                Width="176"
                Height="176"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <FontIcon
                        FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                        FontSize="42"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE93C;" />
                    <Image
                        x:Name="WidePlaylistCoverImage"
                        Stretch="UniformToFill" />
                </Grid>
            </Border>

            <Grid
                Grid.Column="1"
                VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 主标题 -->
                <TextBlock
                    x:Name="WidePlaylistNameText"
                    Grid.Row="0"
                    Grid.Column="0"
                    FontSize="34"
                    FontWeight="SemiBold"
                    MaxLines="1"
                    TextTrimming="CharacterEllipsis"
                    Margin="-4,0,0,0" />

                <!-- 歌曲信息（创建时间+歌曲数量），与标题同行靠右 -->
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="0,11,0,0">
                    <TextBlock
                        x:Name="WideCreatedTimeText"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        x:Name="WideSongCountText"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- 副标题（描述） -->
                <TextBlock
                    x:Name="WidePlaylistDescriptionText"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    MaxLines="4"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Margin="-1,4,0,0" />

                <!-- 播放全部按钮 -->
                <Button
                    x:Name="WidePlayButton"
                    Grid.Row="3"
                    Grid.Column="0"
                    Width="132"
                    Height="38"
                    Padding="20,0"
                    Click="PlayButton_Click"
                    CornerRadius="19">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="12" Glyph="&#xE768;" />
                        <TextBlock Text="播放全部" />
                    </StackPanel>
                </Button>

                <!-- 操作按钮 + 搜索框（同一行靠右） -->
                <StackPanel
                    Grid.Row="3"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="WideEditPlaylistButton"
                        Height="32"
                        Padding="10,0"
                        Click="EditPlaylistButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE70F;" />
                            <TextBlock Text="编辑" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="WideAddSongsButton"
                        Height="32"
                        Padding="10,0"
                        Click="AddSongsButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE710;" />
                            <TextBlock Text="添加" />
                        </StackPanel>
                    </Button>
                    <ToggleButton
                        x:Name="WideMultiSelectToggle"
                        Height="32"
                        Padding="8,0"
                        Click="MultiSelectToggle_Click">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon FontSize="12" Glyph="&#xEA98;" />
                            <TextBlock Text="多选" />
                        </StackPanel>
                    </ToggleButton>
                    <AutoSuggestBox
                        x:Name="WideSongSearchBox"
                        Width="320"
                        Height="32"
                        MinWidth="260"
                        PlaceholderText="搜索歌曲"
                        QueryIcon="Find"
                        QuerySubmitted="SongSearchBox_QuerySubmitted"
                        TextChanged="SongSearchBox_TextChanged" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ==================== 中等宽度窗口布局（600-900px） ==================== -->
        <!-- 第一行：封面 + 标题描述播放按钮；第二行：搜索框 + 操作按钮 -->
        <Grid
            x:Name="MediumHeaderLayout"
            Grid.Row="0"
            RowSpacing="16"
            Padding="24,0"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 第一行：封面 + 标题/描述/播放全部 -->
            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="MediumCoverBorder"
                    Width="140"
                    Height="140"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <FontIcon
                            FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                            FontSize="36"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE93C;" />
                        <Image
                            x:Name="MediumPlaylistCoverImage"
                            Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <Grid
                    Grid.Column="1"
                    VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 主标题 + 歌曲信息 -->
                    <TextBlock
                        x:Name="MediumPlaylistNameText"
                        Grid.Row="0"
                        Grid.Column="0"
                        FontSize="28"
                        FontWeight="SemiBold"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Spacing="12"
                        Margin="0,6,0,0">
                        <TextBlock
                            x:Name="MediumCreatedTimeText"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="MediumSongCountText"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- 副标题（描述） -->
                    <TextBlock
                        x:Name="MediumPlaylistDescriptionText"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Margin="0,2,0,0" />

                    <!-- 播放全部按钮 + 操作按钮 -->
                    <Button
                        x:Name="MediumPlayButton"
                        Grid.Row="2"
                        Grid.Column="0"
                        Width="132"
                        Height="34"
                        Padding="20,0"
                        VerticalAlignment="Bottom"
                        Click="PlayButton_Click"
                        CornerRadius="17">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="12" Glyph="&#xE768;" />
                            <TextBlock Text="播放全部" />
                        </StackPanel>
                    </Button>
                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom">
                        <Button
                            x:Name="MediumEditPlaylistButton"
                            Height="32"
                            Padding="10,0"
                            Click="EditPlaylistButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE70F;" />
                                <TextBlock Text="编辑" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="MediumAddSongsButton"
                            Height="32"
                            Padding="10,0"
                            Click="AddSongsButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                <TextBlock Text="添加" />
                            </StackPanel>
                        </Button>
                        <ToggleButton
                            x:Name="MediumMultiSelectToggle"
                            Height="32"
                            Padding="8,0"
                            Click="MultiSelectToggle_Click">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontSize="12" Glyph="&#xEA98;" />
                                <TextBlock Text="多选" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 第二行：搜索框 -->
            <AutoSuggestBox
                x:Name="MediumSongSearchBox"
                Grid.Row="1"
                Height="32"
                PlaceholderText="搜索歌曲"
                QueryIcon="Find"
                QuerySubmitted="SongSearchBox_QuerySubmitted"
                TextChanged="SongSearchBox_TextChanged" />
        </Grid>

        <!-- ==================== 窄窗口布局（<600px） ==================== -->
        <!-- 第一行：封面 + 标题/描述/播放全部；第二行：搜索框 -->
        <Grid
            x:Name="NarrowHeaderLayout"
            Grid.Row="0"
            RowSpacing="12"
            Padding="24,0"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 第一行：封面 + 标题/描述/播放全部 -->
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="NarrowCoverBorder"
                    Width="140"
                    Height="140"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <FontIcon
                            FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                            FontSize="36"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE93C;" />
                        <Image
                            x:Name="NarrowPlaylistCoverImage"
                            Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <Grid
                    Grid.Column="1"
                    VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 主标题 -->
                    <TextBlock
                        x:Name="NarrowPlaylistNameText"
                        Grid.Row="0"
                        FontSize="28"
                        FontWeight="SemiBold"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />

                    <!-- 副标题（描述） -->
                    <TextBlock
                        x:Name="NarrowPlaylistDescriptionText"
                        Grid.Row="1"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Margin="0,2,0,0" />

                    <!-- 播放全部按钮 -->
                    <Button
                        x:Name="NarrowPlayButton"
                        Grid.Row="2"
                        Grid.Column="0"
                        Width="132"
                        Height="34"
                        Padding="20,0"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Left"
                        Click="PlayButton_Click"
                        CornerRadius="17">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="12" Glyph="&#xE768;" />
                            <TextBlock Text="播放全部" />
                        </StackPanel>
                    </Button>

                    <!-- 操作按钮 -->
                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom">
                        <Button
                            x:Name="NarrowEditPlaylistButton"
                            Height="32"
                            Padding="10,0"
                            Click="EditPlaylistButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE70F;" />
                                <TextBlock Text="编辑" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="NarrowAddSongsButton"
                            Height="32"
                            Padding="10,0"
                            Click="AddSongsButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE710;" />
                                <TextBlock Text="添加" />
                            </StackPanel>
                        </Button>
                        <ToggleButton
                            x:Name="NarrowMultiSelectToggle"
                            Height="32"
                            Padding="8,0"
                            Click="MultiSelectToggle_Click">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontSize="12" Glyph="&#xEA98;" />
                                <TextBlock Text="多选" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 第二行：搜索框 -->
            <AutoSuggestBox
                x:Name="NarrowSongSearchBox"
                Grid.Row="1"
                Height="32"
                PlaceholderText="搜索歌曲"
                QueryIcon="Find"
                QuerySubmitted="SongSearchBox_QuerySubmitted"
                TextChanged="SongSearchBox_TextChanged" />
        </Grid>

        <!-- ==================== 底部区域：歌曲列表 ==================== -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="MultiSelectToolbar"
                Grid.Row="0"
                Margin="24,0,2,8"
                Padding="12,8"
                ColumnSpacing="8"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    x:Name="SelectAllCheckBox"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Content="全选"
                    Click="SelectAllCheckBox_Click" />
                <TextBlock
                    x:Name="SelectedCountText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="12,0,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button
                    x:Name="MultiSelectDeleteButton"
                    Grid.Column="2"
                    Height="32"
                    Padding="8,0"
                    Click="MultiSelectDeleteButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="12" Glyph="&#xE74D;" />
                        <TextBlock Text="从歌单移除" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="MultiSelectPlayAllButton"
                    Grid.Column="3"
                    Height="32"
                    Padding="8,0"
                    Click="MultiSelectPlayAllButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="12" Glyph="&#xE768;" />
                        <TextBlock Text="播放选中" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid
                x:Name="ListHeader"
                Grid.Row="1"
                Padding="12,8"
                Margin="24,0"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="AlbumColumn2" Width="220" />
                    <ColumnDefinition x:Name="DurationColumn" Width="72" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="封面" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="标题" />
                <TextBlock
                    x:Name="AlbumColumnHeader"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="专辑" />
                <TextBlock
                    x:Name="DurationColumnHeader"
                    Grid.Column="3"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="时长" />
            </Grid>

            <ListView
                x:Name="SongList"
                Grid.Row="2"
                Padding="0,0,24,116"
                IsItemClickEnabled="True"
                ItemClick="SongList_ItemClick"
                ContainerContentChanging="SongList_ContainerContentChanging"
                ItemContainerStyle="{StaticResource PlaylistSongListViewItemStyle}"
                ItemTemplate="{StaticResource PlaylistSongItemTemplate}"
                SelectionMode="None">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </ListView>

            <TextBlock
                x:Name="EmptyStateText"
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
