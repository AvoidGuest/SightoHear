<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SightoHear.RecycleBinPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SightoHear"
    xmlns:models="using:SightoHear.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled"
    Background="Transparent">

    <Page.Resources>
        <FontFamily x:Key="SegoeFluentIconsFontFamily">/Assets/Fonts/Segoe Fluent Icons.ttf#Segoe Fluent Icons</FontFamily>

        <!-- 列表项样式：严格参考 MusicPage / PlaylistDetailPage -->
        <Style x:Key="RecycleBinListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="MinHeight" Value="56" />
        </Style>

        <!-- 列表项模板：Border 自身携带背景、边框、圆角，不依赖 ListViewItem 样式 -->
        <DataTemplate x:Key="RecycleBinItemTemplate" x:DataType="models:RecycleBinItem">
            <Border
                Height="56"
                Padding="12,8"
                Tag="{x:Bind}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                DoubleTapped="ItemCard_DoubleTapped">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>

                    <!-- 图标 -->
                    <Border
                        Grid.Column="0"
                        Width="28"
                        Height="28"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="4"
                        VerticalAlignment="Center">
                        <FontIcon
                            FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                            Glyph="&#xE8B7;"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                    <!-- 文件名 -->
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind FileName}"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        FontSize="13"
                        TextTrimming="CharacterEllipsis" />

                    <!-- 原始位置 -->
                    <TextBlock
                        Grid.Column="2"
                        Text="{x:Bind OriginalPath}"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        FontSize="12" />

                    <!-- 删除日期 -->
                    <TextBlock
                        Grid.Column="3"
                        Text="{x:Bind DeletedDateText}"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        FontSize="12" />

                    <!-- 选择框 -->
                    <CheckBox
                        x:Name="ItemCheckBox"
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        PointerPressed="ItemCheckBox_PointerPressed"
                        DoubleTapped="ItemCheckBox_DoubleTapped"
                        Checked="ItemCheckBox_Checked"
                        Unchecked="ItemCheckBox_Unchecked" />

                    <!-- 大小 -->
                    <TextBlock
                        Grid.Column="5"
                        Text="{x:Bind SizeText}"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        FontSize="12"
                        TextAlignment="Right" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 空状态模板 -->
        <DataTemplate x:Key="EmptyStateTemplate">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <FontIcon
                    FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                    Glyph="&#xE74D;"
                    FontSize="48"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    Text="回收站为空"
                    FontSize="16"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    Text="删除的文件将显示在这里"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </DataTemplate>

        <!-- 上下文菜单资源 -->
        <MenuFlyout x:Key="ItemContextMenu">
            <MenuFlyoutItem Text="还原" Icon="Refresh" Click="RestoreItem_Click" />
            <MenuFlyoutItem Text="永久删除" Icon="Delete" Click="DeleteItem_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="属性" Click="ItemProperties_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" Glyph="&#xE946;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="28,24,28,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="回收站" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
            <local:InfoButton
                x:Name="RecycleBinInfoButton"
                Grid.Column="1"
                Style="{StaticResource StaticInfoButtonStyle}"
                Width="20"
                Height="20"
                CornerRadius="10"
                Margin="8,4,0,0"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                Click="RecycleBinInfoButton_Click">
                <TextBlock Text="i"
                           FontSize="12"
                           FontWeight="Bold"
                           FontFamily="Segoe UI"
                           FontStyle="Italic"
                           VerticalAlignment="Center"/>
            </local:InfoButton>
        </Grid>

        <!-- 工具栏 -->
        <Grid Grid.Row="1" Margin="24,12,24,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="0"
                MinWidth="300"
                PlaceholderText="搜索回收站文件"
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged" />

            <TextBlock
                x:Name="StatusText"
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <ToggleButton
                x:Name="MultiSelectButton"
                Grid.Column="2"
                Height="32"
                Margin="0,0,8,0"
                Padding="8,0"
                Click="MultiSelectButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" FontSize="12" Glyph="&#xEA98;" />
                    <TextBlock Text="多选" />
                </StackPanel>
            </ToggleButton>

            <Button
                x:Name="RefreshButton"
                Grid.Column="3"
                Height="32"
                Margin="0,0,8,0"
                Padding="8,0"
                Click="RefreshButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" FontSize="12" Glyph="&#xE72C;" />
                    <TextBlock Text="刷新" />
                </StackPanel>
            </Button>

            <Button
                x:Name="EmptyButton"
                Grid.Column="4"
                Height="32"
                Padding="8,0"
                Click="EmptyButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" FontSize="12" Glyph="&#xE74D;" />
                    <TextBlock Text="清空回收站" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 内容区：三行结构（多选工具栏 / 列表头 / 列表） -->
        <Grid Grid.Row="2" Margin="24,4,0,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 多选工具栏（悬浮样式，默认隐藏） -->
            <Border
                x:Name="BatchActionBar"
                Grid.Row="0"
                Height="48"
                Margin="0,0,24,8"
                Padding="12,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox
                        x:Name="SelectAllCheckBox"
                        Grid.Column="0"
                        Content="全选"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Checked="SelectAllCheckBox_Checked"
                        Unchecked="SelectAllCheckBox_Unchecked" />

                    <TextBlock
                        x:Name="SelectedCountText"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Text="已选择 0 项" />

                    <Button
                        x:Name="RestoreSelectedButton"
                        Grid.Column="2"
                        Height="32"
                        Padding="12,0"
                        Click="RestoreSelectedButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" FontSize="12" Glyph="&#xE73F;" />
                            <TextBlock Text="还原选中" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="DeleteSelectedButton"
                        Grid.Column="3"
                        Height="32"
                        Padding="12,0"
                        Click="DeleteSelectedButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon FontFamily="{StaticResource SegoeFluentIconsFontFamily}" FontSize="12" Glyph="&#xE74D;" />
                            <TextBlock Text="永久删除" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="CancelMultiSelectButton"
                        Grid.Column="4"
                        Height="32"
                        Padding="12,0"
                        Click="CancelMultiSelectButton_Click">
                        <TextBlock Text="取消" />
                    </Button>
                </Grid>
            </Border>

            <!-- 列表头（常驻显示） -->
            <Grid
                x:Name="ListHeader"
                Grid.Row="1"
                Margin="0,0,24,0"
                Padding="12,8"
                ColumnSpacing="12"
                Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="名称" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="原始位置" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="删除日期" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="大小" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>

            <!-- 列表 -->
            <ListView
                x:Name="ItemsList"
                Grid.Row="2"
                Padding="0,0,24,24"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemContainerStyle="{StaticResource RecycleBinListItemStyle}"
                ItemTemplate="{StaticResource RecycleBinItemTemplate}"
                Loaded="ItemsList_Loaded"
                ItemClick="ItemsList_ItemClick"
                RightTapped="ItemsList_RightTapped">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </ListView>

            <!-- 空状态 -->
            <TextBlock
                x:Name="EmptyStateText"
                Grid.Row="2"
                Text="回收站为空，删除的文件将显示在这里"
                Style="{StaticResource BodyTextBlockStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,40,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="Collapsed" />
        </Grid>

        <TeachingTip
            x:Name="RecycleBinTeachingTip"
            Target="{x:Bind RecycleBinInfoButton}"
            Title=""
            Subtitle="">
            <StackPanel>
                <TextBlock Text="回收站是Windows的原生功能"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <TextBlock Text="回收站由Windows Shell API提供，它记录的是Windows原生回收站内容。"
                           FontSize="12"
                           FontWeight="Normal"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </TeachingTip>
    </Grid>

</Page>
