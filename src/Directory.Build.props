<Project>
  <PropertyGroup>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>

    <!-- ★ 构建模式开关（与 SightoHear.csproj 中的定义保持一致）：
           true / 空 → MSIX 安装包模式（默认，兼容旧行为）
           false     → 便携版免安装模式
         这里必须先给出默认值：本文件比 csproj 更早被导入，
         如果只在 csproj 里定义，下面按模式切分输出目录时会读到空值。 -->
    <SightoHearMsix Condition="'$(SightoHearMsix)' == ''">true</SightoHearMsix>

    <!-- Configuration 统一用标准命名（Debug/Release），不再使用特殊的 DeBug 大小写 -->
    <OutputConfigurationFolder Condition="'$(Configuration)' == 'Debug'">Debug</OutputConfigurationFolder>
    <OutputConfigurationFolder Condition="'$(Configuration)' != 'Debug'">$(Configuration)</OutputConfigurationFolder>

    <!-- 平台目录统一为小写架构名（x86/x64/arm64），与 MSIX 包文件名、ProcessorArchitecture 一致 -->
    <OutputPlatformFolder Condition="'$(Platform)' == 'x86'">x86</OutputPlatformFolder>
    <OutputPlatformFolder Condition="'$(Platform)' == 'x64'">x64</OutputPlatformFolder>
    <OutputPlatformFolder Condition="'$(Platform)' == 'ARM64'">arm64</OutputPlatformFolder>
    <OutputPlatformFolder Condition="'$(OutputPlatformFolder)' == ''">$(Platform)</OutputPlatformFolder>

    <!-- ==================== 输出目录（按构建模式分流） ====================
         MSIX 模式：中间产物统一落 artifacts\<Config>\<平台>\，
                     bin\<Config>\<平台>\ 只放最终 .msix。
         便携版模式：可运行产物落 bin\<Config>\<平台>\Portable\（整个文件夹可拷走直接双击），
                      中间产物落 obj\<Config>\<平台>\，不污染可运行目录。

         ★ 便携版为什么放在 bin\<Config>\<平台>\Portable\ 这个子目录：
           bin\<Config>\<平台>\ 本身就是安装包区，两种产物直接混在一起会互相干扰
           （实测便携版目录里混入过 1.2GB 历史 .msix）。
           收进 Portable\ 子目录后，同一个平台目录下「安装包在根、便携版在子目录」，
           层级清晰，且 build-msix.ps1 只往根目录写 .msix、不会动这个子目录。
         ★ 两种模式路径完全隔离，可在同一台机器上反复切换构建而互不污染。 -->

    <!-- ① MSIX 模式（默认） -->
    <BaseOutputPath      Condition="'$(SightoHearMsix)' == 'true'">$(MSBuildThisFileDirectory)artifacts\</BaseOutputPath>
    <OutputPath          Condition="'$(SightoHearMsix)' == 'true'">$(MSBuildThisFileDirectory)artifacts\$(OutputConfigurationFolder)\$(OutputPlatformFolder)\</OutputPath>
    <BaseIntermediateOutputPath Condition="'$(SightoHearMsix)' == 'true'">$(MSBuildThisFileDirectory)artifacts\$(OutputConfigurationFolder)\$(OutputPlatformFolder)\obj\</BaseIntermediateOutputPath>

    <!-- ② 便携版模式（bin\<Config>\<平台>\Portable\） -->
    <BaseOutputPath      Condition="'$(SightoHearMsix)' != 'true'">$(MSBuildThisFileDirectory)bin\</BaseOutputPath>
    <OutputPath          Condition="'$(SightoHearMsix)' != 'true'">$(MSBuildThisFileDirectory)bin\$(OutputConfigurationFolder)\$(OutputPlatformFolder)\Portable\</OutputPath>
    <BaseIntermediateOutputPath Condition="'$(SightoHearMsix)' != 'true'">$(MSBuildThisFileDirectory)obj\$(OutputConfigurationFolder)\$(OutputPlatformFolder)\</BaseIntermediateOutputPath>

    <IntermediateOutputPath>$(BaseIntermediateOutputPath)</IntermediateOutputPath>

    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**;artifacts\**</DefaultItemExcludes>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
</Project>
