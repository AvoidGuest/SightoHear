<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SightoHear.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SightoHear">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="SightoHearAccentBrush" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="DangerButtonBackground" Color="#FFE81123"/>
            <SolidColorBrush x:Key="DangerButtonBackgroundPointerOver" Color="#FFD41228"/>
            <SolidColorBrush x:Key="DangerButtonBackgroundPressed" Color="#FFBA0A1C"/>

            <!-- ══════════════════════════════════════════════════════════════
                 ★ 主题色资源预注册（统一在此处注册，避免 SetBrushResource 走"新建"分支）
                 SetBrushResource 仅对【已注册且是 SolidColorBrush 的 key】复用实例修改 Color，
                 已加载控件才会即时重绘。未注册的 key 会新建 brush 放入资源字典，
                 已加载控件仍引用旧实例 → 必须悬停（视觉状态切换强制重绘）或延迟后才显示新颜色。
                 因此所有 ApplyGlobalAccentColor 更新的资源 key 都必须在此预注册。
                 ══════════════════════════════════════════════════════════════ -->

            <!-- Slider 轨道填充（进度条已填充部分） -->
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#660078D4"/>

            <!-- Slider Thumb（进度条头部圆点）：此前未注册导致"头部主题色不更新" -->
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#660078D4"/>
            <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="SliderThumbBorderBrushPointerOver" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="SliderThumbBorderBrushPressed" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="SliderThumbBorderBrushDisabled" Color="#660078D4"/>

            <!-- ProgressBar 前景（进度条控件） -->
            <SolidColorBrush x:Key="ProgressBarForegroundThemeBrush" Color="#FF0078D4"/>

            <!-- 通用强调色（CheckBox/ToggleSwitch/RadioButton/列表选中等 WinUI 控件模板引用） -->
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="SystemControlHighlightAccent3Brush" Color="#FF0078D4"/>

            <!-- AccentButton 系列（ContentDialog 主按钮 / ImageCropDialog 的 AccentButtonStyle） -->
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#660078D4"/>
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#66FFFFFF"/>
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="#660078D4"/>

            <!-- HyperlinkButton 前景（默认引用系统强调色） -->
            <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="HyperlinkButtonForegroundDisabled" Color="#660078D4"/>

            <!-- AccentFill 系列（WinUI 控件填充强调色） -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E60078D4"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC0078D4"/>
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#660078D4"/>

            <!-- AccentTextFill 系列（WinUI 文本强调色） -->
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#E60078D4"/>
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#CC0078D4"/>
            <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush" Color="#660078D4"/>

            <!-- ToggleSwitch 开启态（39 个设置开关） -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#660078D4"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="#660078D4"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="#660078D4"/>

            <!-- CheckBox 勾选态（47 个多选复选框） -->
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedDisabled" Color="#660078D4"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#FF0078D4"/>
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedDisabled" Color="#660078D4"/>

            <!-- 设置页 SettingsCard 等使用的强调色资源 -->
            <SolidColorBrush x:Key="SettingsCardBackgroundColor" Color="Transparent"/>
            <SolidColorBrush x:Key="SettingsCardBorderColor" Color="Transparent"/>
            <!-- Segoe Fluent Icons 内置字体 -->
            <FontFamily x:Key="SegoeFluentIconsFontFamily">/Assets/Fonts/Segoe Fluent Icons.ttf#Segoe Fluent Icons</FontFamily>
            <!-- Other app resources here -->

            <!-- 危险操作按钮样式（用于删除确认等） -->
            <Style x:Key="DangerButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource DangerButtonBackground}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="MinHeight" Value="32"/>
            </Style>

            <Style x:Key="StaticInfoButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource GpuInfoButtonBackground}"/>
                <Setter Property="Foreground" Value="{ThemeResource GpuInfoButtonForeground}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="UseSystemFocusVisuals" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="QueueCardBackgroundBrush" Color="#FFF9F9F9"/>
                    <SolidColorBrush x:Key="QueueCardBorderBrush" Color="#FFD0D0D0"/>
                    <SolidColorBrush x:Key="GpuInfoButtonBackground" Color="#FF0070CB"/>
                    <SolidColorBrush x:Key="GpuInfoButtonForeground" Color="White"/>
                    <SolidColorBrush x:Key="ColorSelectionBorderBrush" Color="Black"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="QueueCardBackgroundBrush" Color="#FF1C1C1C"/>
                    <SolidColorBrush x:Key="QueueCardBorderBrush" Color="#FF3A3A3A"/>
                    <SolidColorBrush x:Key="GpuInfoButtonBackground" Color="#FF60CDFF"/>
                    <SolidColorBrush x:Key="GpuInfoButtonForeground" Color="Black"/>
                    <SolidColorBrush x:Key="ColorSelectionBorderBrush" Color="White"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
