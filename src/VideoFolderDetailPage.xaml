<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SightoHear.VideoFolderDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SightoHear"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SightoHear.Models"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <local:FilePathToImageConverter x:Key="VideoCoverConverter" />

        <Style x:Key="FolderVideoListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <DataTemplate x:Key="FolderVideoItemTemplate" x:DataType="models:MediaItem">
            <Border
                Height="64"
                Padding="12,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                DoubleTapped="VideoItem_DoubleTapped"
                RightTapped="VideoItem_RightTapped"
                Tag="{x:Bind}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>

                    <!-- 缩略图 -->
                    <Border
                        Grid.Column="0"
                        Width="40"
                        Height="40"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="4">
                        <Grid>
                            <FontIcon
                                FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                                FontSize="16"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE8B2;" />
                            <Image
                                x:Name="ThumbnailImage"
                                Source="{x:Bind ThumbnailPath, Converter={StaticResource VideoCoverConverter}}"
                                Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <!-- 文件名 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{x:Bind FileName}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- 时长 -->
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind DurationText}"
                        TextTrimming="CharacterEllipsis" />

                    <!-- 文件大小 -->
                    <TextBlock
                        Grid.Column="3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind FileSizeText}" />

                    <CheckBox
                        x:Name="ItemCheckBox"
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Checked="FolderVideoCheckBox_Checked"
                        Unchecked="FolderVideoCheckBox_Unchecked" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,24,24,0" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 宽窗口布局（≥900px） ==================== -->
        <Grid
            x:Name="WideHeaderLayout"
            Grid.Row="0"
            ColumnSpacing="24"
            Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Width="176"
                Height="176"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <FontIcon
                        FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                        FontSize="42"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE8B7;" />
                    <Image
                        x:Name="WideFolderCoverImage"
                        Stretch="UniformToFill" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" Spacing="6">
                    <TextBlock
                        x:Name="WideFolderNameText"
                        FontSize="34"
                        FontWeight="SemiBold"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="WideFolderPathText"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        x:Name="WideFolderStatText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button
                    x:Name="WidePlayButton"
                    Grid.Row="1"
                    Width="132"
                    Height="38"
                    Padding="20,0"
                    Margin="-3,-1,0,0"
                    Click="PlayButton_Click"
                    CornerRadius="19">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="12" Glyph="&#xE768;" />
                        <TextBlock Text="播放全部" />
                    </StackPanel>
                </Button>
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ToggleButton
                        x:Name="WideMultiSelectToggle"
                        Height="32"
                        Padding="8,0"
                        Click="MultiSelectToggle_Click">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon FontSize="12" Glyph="&#xEA98;" />
                            <TextBlock Text="多选" />
                        </StackPanel>
                    </ToggleButton>
                    <AutoSuggestBox
                        x:Name="WideVideoSearchBox"
                        Width="320"
                        MinWidth="260"
                        PlaceholderText="搜索视频"
                        QueryIcon="Find"
                        TextChanged="VideoSearchBox_TextChanged" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ==================== 中等宽度窗口布局（600-900px） ==================== -->
        <Grid
            x:Name="MediumHeaderLayout"
            Grid.Row="0"
            RowSpacing="16"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="140"
                    Height="140"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <FontIcon
                            FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                            FontSize="36"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8B7;" />
                        <Image
                            x:Name="MediumFolderCoverImage"
                            Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <Grid Grid.Column="1" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="MediumFolderNameText"
                        Grid.Row="0"
                        Grid.Column="0"
                        FontSize="28"
                        FontWeight="SemiBold"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis" />
                    <!-- ★ 路径与统计独立成行并右对齐，避免与标题挤在同一行被压扁 -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Spacing="4"
                        Margin="0,4,0,0">
                        <TextBlock
                            x:Name="MediumFolderStatText"
                            FontSize="12"
                            HorizontalAlignment="Right"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <TextBlock
                        x:Name="MediumFolderPathText"
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        FontSize="12"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <StackPanel
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0">
                        <Button
                            x:Name="MediumPlayButton"
                            Width="132"
                            Height="34"
                            Padding="20,0"
                            Click="PlayButton_Click"
                            CornerRadius="17">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="12" Glyph="&#xE768;" />
                                <TextBlock Text="播放全部" />
                            </StackPanel>
                        </Button>
                        <ToggleButton
                            x:Name="MediumMultiSelectToggle"
                            Height="32"
                            Padding="8,0"
                            Click="MultiSelectToggle_Click">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontSize="12" Glyph="&#xEA98;" />
                                <TextBlock Text="多选" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Grid>

            <AutoSuggestBox
                x:Name="MediumVideoSearchBox"
                Grid.Row="1"
                Height="32"
                PlaceholderText="搜索视频"
                QueryIcon="Find"
                TextChanged="VideoSearchBox_TextChanged" />
        </Grid>

        <!-- ==================== 窄窗口布局（<600px） ==================== -->
        <Grid
            x:Name="NarrowHeaderLayout"
            Grid.Row="0"
            RowSpacing="12"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="96"
                    Height="96"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <FontIcon
                            FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                            FontSize="28"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8B7;" />
                        <Image
                            x:Name="NarrowFolderCoverImage"
                            Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <Grid Grid.Column="1" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="NarrowFolderNameText"
                        Grid.Row="0"
                        FontSize="22"
                        FontWeight="SemiBold"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Row="1" Spacing="2" Margin="0,2,0,0">
                        <TextBlock
                            x:Name="NarrowFolderStatText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="NarrowFolderPathText"
                            FontSize="12"
                            TextTrimming="CharacterEllipsis"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0">
                        <Button
                            x:Name="NarrowPlayButton"
                            Width="132"
                            Height="34"
                            Padding="20,0"
                            Click="PlayButton_Click"
                            CornerRadius="17">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="12" Glyph="&#xE768;" />
                                <TextBlock Text="播放全部" />
                            </StackPanel>
                        </Button>
                        <ToggleButton
                            x:Name="NarrowMultiSelectToggle"
                            Height="32"
                            Padding="8,0"
                            Click="MultiSelectToggle_Click">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontSize="12" Glyph="&#xEA98;" />
                                <TextBlock Text="多选" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Grid>

            <AutoSuggestBox
                x:Name="NarrowVideoSearchBox"
                Grid.Row="1"
                Height="32"
                PlaceholderText="搜索视频"
                QueryIcon="Find"
                TextChanged="VideoSearchBox_TextChanged" />
        </Grid>

        <!-- 底部区域：内容列表 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 多选工具栏 -->
            <Grid
                x:Name="MultiSelectToolbar"
                Grid.Row="0"
                Margin="24,0,2,8"
                Padding="12,8"
                ColumnSpacing="8"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    x:Name="SelectAllCheckBox"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Content="全选"
                    Click="SelectAllCheckBox_Click" />
                <TextBlock
                    x:Name="SelectedCountText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Margin="12,0,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button
                    x:Name="MultiSelectDeleteButton"
                    Grid.Column="2"
                    Height="32"
                    Padding="8,0"
                    Click="MultiSelectDeleteButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="12" Glyph="&#xE74D;" />
                        <TextBlock Text="删除" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="MultiSelectPlayAllButton"
                    Grid.Column="3"
                    Height="32"
                    Padding="8,0"
                    Click="MultiSelectPlayAllButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="12" Glyph="&#xE768;" />
                        <TextBlock Text="播放选中" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 列表头 -->
            <Grid
                x:Name="ListHeader"
                Grid.Row="1"
                Padding="12,8"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="封面" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="文件名" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="时长" />
                <TextBlock
                    Grid.Column="3"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="大小" />
            </Grid>

            <!-- 视频列表 -->
            <ListView
                x:Name="VideoList"
                Grid.Row="2"
                Padding="0,0,0,116"
                IsItemClickEnabled="True"
                ItemClick="VideoList_ItemClick"
                ContainerContentChanging="VideoList_ContainerContentChanging"
                ItemContainerStyle="{StaticResource FolderVideoListViewItemStyle}"
                ItemTemplate="{StaticResource FolderVideoItemTemplate}"
                SelectionMode="None">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </ListView>

            <!-- 空状态提示 -->
            <TextBlock
                x:Name="EmptyStateText"
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
