<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SightoHear.MusicPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SightoHear.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SightoHear"
    xmlns:models="using:SightoHear.Models"
    Background="#FF0D0B10"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="PlayerTextBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="PlayerSecondaryTextBrush" Color="#B8FFFFFF" />
        <SolidColorBrush x:Key="PlayerTertiaryTextBrush" Color="#75FFFFFF" />
        <SolidColorBrush x:Key="PlayerControlIconBrush" Color="#FFFFFFFF" />
        <local:FilePathToImageConverter x:Key="MusicCoverConverter" />

        <Style x:Key="PlayerGhostButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{StaticResource PlayerControlIconBrush}" />
        </Style>

        <Style x:Key="PlayerPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayerGhostButtonStyle}">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="54" />
            <Setter Property="CornerRadius" Value="27" />
            <Setter Property="Background" Value="#2BFFFFFF" />
            <Setter Property="BorderBrush" Value="#24FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <DataTemplate x:Key="QueueItemDefaultTemplate">
                <Border Height="56" Padding="12,6"
                        Background="{ThemeResource QueueCardBackgroundBrush}"
                        BorderBrush="{ThemeResource QueueCardBorderBrush}"
                        BorderThickness="1" CornerRadius="4"
                        PointerEntered="QueueItem_PointerEntered" PointerExited="QueueItem_PointerExited"
                        PointerPressed="QueueItem_PointerPressed" PointerReleased="QueueItem_PointerReleased"
                        PointerCanceled="QueueItem_PointerCanceled">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4">
                            <Image Source="{Binding CoverDisplayPath, Converter={StaticResource MusicCoverConverter}}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ArtistDisplay}" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="QueueItemNowPlayingTemplate">
                <Border Height="56" Padding="12,6"
                        Background="{ThemeResource QueueCardBackgroundBrush}"
                        BorderBrush="{ThemeResource QueueCardBorderBrush}"
                        BorderThickness="1" CornerRadius="4"
                        PointerEntered="QueueItem_PointerEntered" PointerExited="QueueItem_PointerExited"
                        PointerPressed="QueueItem_PointerPressed" PointerReleased="QueueItem_PointerReleased"
                        PointerCanceled="QueueItem_PointerCanceled">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4">
                            <Image Source="{Binding CoverDisplayPath, Converter={StaticResource MusicCoverConverter}}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="正在播放" FontSize="11" Foreground="{ThemeResource SystemAccentColor}"/>
                                <TextBlock Text="{Binding ArtistDisplay}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                        <Grid x:Name="QueueEqualizerHost" Grid.Column="2" Width="32" Height="14" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="2"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="2"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="2"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="2"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="QBar1" Width="3" Height="14"
                                       Fill="{ThemeResource TextFillColorPrimaryBrush}" RadiusX="1" RadiusY="1" VerticalAlignment="Center"/>
                            <Rectangle x:Name="QBar2" Width="3" Height="14"
                                       Fill="{ThemeResource TextFillColorPrimaryBrush}" RadiusX="1" RadiusY="1" VerticalAlignment="Center" Grid.Column="2"/>
                            <Rectangle x:Name="QBar3" Width="3" Height="14"
                                       Fill="{ThemeResource TextFillColorPrimaryBrush}" RadiusX="1" RadiusY="1" VerticalAlignment="Center" Grid.Column="4"/>
                            <Rectangle x:Name="QBar4" Width="3" Height="14"
                                       Fill="{ThemeResource TextFillColorPrimaryBrush}" RadiusX="1" RadiusY="1" VerticalAlignment="Center" Grid.Column="6"/>
                            <Rectangle x:Name="QBar5" Width="3" Height="14"
                                       Fill="{ThemeResource TextFillColorPrimaryBrush}" RadiusX="1" RadiusY="1" VerticalAlignment="Center" Grid.Column="8"/>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
    </Page.Resources>

    <Grid
        x:Name="RootGrid"
        Background="#FF0D0B10">
        <controls:FreeRunCanvas
            x:Name="BackgroundCanvas"
            ClearColor="#FF0D0B10"
            CreateResources="BackgroundCanvas_CreateResources"
            Draw="BackgroundCanvas_Draw"
            IsHitTestVisible="False"
            Update="BackgroundCanvas_Update" />

        <Rectangle Opacity="0.06">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#18000000" Offset="0.56" />
                    <GradientStop Color="#2A000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Button
            x:Name="BackButton"
            Width="44"
            Height="44"
            Margin="22"
            Padding="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="#26000000"
            BorderBrush="#22FFFFFF"
            BorderThickness="1"
            Click="BackButton_Click"
            CornerRadius="22"
            ToolTipService.ToolTip="返回">
            <FontIcon
                FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                FontSize="15"
                Foreground="White"
                Glyph="&#xE72B;" />
        </Button>

        <Grid Margin="84,64,84,122">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.94*" />
                <ColumnDefinition Width="1.06*" />
            </Grid.ColumnDefinitions>

            <Viewbox
                Grid.Column="0"
                MaxWidth="600"
                MaxHeight="820"
                Margin="0,18,60,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Stretch="Uniform"
                StretchDirection="Both">
                <Grid
                    x:Name="PlayerInfoArea"
                    RightTapped="PlayerInfoArea_RightTapped">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Width="404"
                        Height="404"
                        HorizontalAlignment="Center"
                        Background="#20000000"
                        BorderBrush="#18FFFFFF"
                        BorderThickness="1"
                        CornerRadius="32">
                        <Grid>
                            <FontIcon
                                FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                                FontSize="82"
                                Foreground="#38FFFFFF"
                                Glyph="&#xE8D6;" />
                            <Image
                                x:Name="CoverImage"
                                Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel
                        Grid.Row="1"
                        Width="440"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        Spacing="0">
                        <TextBlock
                            x:Name="TitleText"
                            Width="440"
                            FontSize="38"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PlayerTextBrush}"
                            MaxLines="2"
                            Text="未播放"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="ArtistText"
                            Width="440"
                            Margin="0,2,0,0"
                            FontSize="20"
                            Foreground="{StaticResource PlayerSecondaryTextBrush}"
                            MaxLines="1"
                            Text="未知艺术家"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="AlbumText"
                            Width="440"
                            Margin="0,14,0,0"
                            FontSize="15"
                            Foreground="{StaticResource PlayerTertiaryTextBrush}"
                            MaxLines="1"
                            Text="未知专辑"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Viewbox>

            <Grid
                x:Name="LyricsHost"
                Grid.Column="1"
                Margin="0,-22,-34,-12"
                Background="Transparent"
                HorizontalAlignment="Stretch"
                PointerExited="LyricsHost_PointerExited"
                PointerMoved="LyricsHost_PointerMoved"
                PointerPressed="LyricsHost_PointerPressed"
                PointerWheelChanged="LyricsHost_PointerWheelChanged"
                VerticalAlignment="Stretch" />
        </Grid>

        <Grid
            x:Name="BottomControlsHost"
            Margin="26,0,26,12"
            Background="Transparent"
            Opacity="0"
            PointerEntered="BottomControlsHost_PointerEntered"
            PointerExited="BottomControlsHost_PointerExited"
            VerticalAlignment="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="PositionText"
                    Margin="4,-2,0,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PlayerTextBrush}"
                    Text="00:00"
                    TextAlignment="Left" />
                <Grid
                    x:Name="ProgressTrack"
                    Grid.Column="1"
                    Height="28"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    PointerCanceled="ProgressSlider_PointerCanceled"
                    PointerEntered="ProgressSlider_PointerEntered"
                    PointerExited="ProgressSlider_PointerExited"
                    PointerMoved="ProgressSlider_PointerMoved"
                    PointerPressed="ProgressSlider_PointerPressed"
                    PointerReleased="ProgressSlider_PointerReleased"
                    SizeChanged="ProgressTrack_SizeChanged">
                    <Border
                        x:Name="ProgressTrackRail"
                        Height="5"
                        VerticalAlignment="Center"
                        Background="#66FFFFFF"
                        CornerRadius="3" />
                    <Border
                        x:Name="ProgressPreviewFill"
                        Width="0"
                        Height="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#9CFFFFFF"
                        CornerRadius="3"
                        Opacity="0" />
                    <Border
                        x:Name="ProgressFill"
                        Width="0"
                        Height="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#F0FFFFFF"
                        CornerRadius="3" />
                    <Border
                        x:Name="ProgressTimeTip"
                        MinWidth="46"
                        Padding="7,3"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="#CC111111"
                        CornerRadius="6"
                        Opacity="0"
                        Translation="0,-26,0">
                        <TextBlock
                            x:Name="ProgressTimeTipText"
                            FontSize="12"
                            Foreground="White"
                            Text="00:00"
                            TextAlignment="Center" />
                    </Border>
                </Grid>
                <TextBlock
                    x:Name="DurationText"
                    Grid.Column="2"
                    Margin="0,-2,3,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PlayerSecondaryTextBrush}"
                    Text="00:00"
                    TextAlignment="Right" />
            </Grid>

            <Grid Grid.Row="1">
                <StackPanel
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="PlayModeButton"
                        Click="PlayModeButton_Click"
                        Style="{StaticResource PlayerGhostButtonStyle}"
                        ToolTipService.ToolTip="顺序播放">
                        <FontIcon
                            x:Name="PlayModeIcon"
                            FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                            FontSize="14"
                            Glyph="&#xE8AB;" />
                    </Button>
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button
                        Click="PreviousButton_Click"
                        Style="{StaticResource PlayerGhostButtonStyle}"
                        ToolTipService.ToolTip="上一曲">
                        <FontIcon
                            FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                            FontSize="16"
                            Glyph="&#xE892;" />
                    </Button>
                    <Button
                        x:Name="PlayPauseButton"
                        Click="PlayPauseButton_Click"
                        Style="{StaticResource PlayerPrimaryButtonStyle}"
                        ToolTipService.ToolTip="播放或暂停">
                        <FontIcon
                            x:Name="PlayPauseIcon"
                            FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                            FontSize="18"
                            Glyph="&#xE768;" />
                    </Button>
                    <Button
                        Click="NextButton_Click"
                        Style="{StaticResource PlayerGhostButtonStyle}"
                        ToolTipService.ToolTip="下一曲">
                        <FontIcon
                            FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                            FontSize="16"
                            Glyph="&#xE893;" />
                    </Button>
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="QueueButton"
                        Style="{StaticResource PlayerGhostButtonStyle}"
                        ToolTipService.ToolTip="播放列表">
                        <FontIcon
                            FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                            FontSize="15"
                            Glyph="&#xE8FD;" />
                    </Button>
                    <Button
                        x:Name="VolumeButton"
                        Style="{StaticResource PlayerGhostButtonStyle}"
                        ToolTipService.ToolTip="音量">
                        <Button.Flyout>
                            <Flyout Placement="Top">
                                <Grid Width="230" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        x:Name="MuteButton"
                                        Width="34"
                                        Height="34"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="MuteButton_Click"
                                        CornerRadius="17">
                                        <FontIcon
                                            x:Name="MuteIcon"
                                            FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                                            FontSize="13"
                                            Glyph="&#xE767;" />
                                    </Button>
                                    <Slider
                                        x:Name="VolumeSlider"
                                        Grid.Column="1"
                                        Minimum="0"
                                        Maximum="100"
                                        ValueChanged="VolumeSlider_ValueChanged" />
                                    <TextBlock
                                        x:Name="VolumeText"
                                        Grid.Column="2"
                                        Width="30"
                                        VerticalAlignment="Center"
                                        Text="80" />
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                        <FontIcon
                            x:Name="VolumeButtonIcon"
                            FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                            FontSize="15"
                            Glyph="&#xE767;" />
                    </Button>
                    <Button
                        x:Name="PlayerSettingsButton"
                        Click="PlayerSettingsButton_Click"
                        Style="{StaticResource PlayerGhostButtonStyle}"
                        ToolTipService.ToolTip="设置">
                        <FontIcon
                            FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                            FontSize="15"
                            Glyph="&#xE713;" />
                    </Button>
                    <Button
                        x:Name="MoreButton"
                        Click="MoreButton_Click"
                        Style="{StaticResource PlayerGhostButtonStyle}"
                        ToolTipService.ToolTip="更多">
                        <FontIcon
                            FontFamily="{StaticResource SegoeFluentIconsFontFamily}"
                            FontSize="15"
                            Glyph="&#xE712;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

            <!-- 播放队列卡片（通过 QueueButton 的 Flyout 展示） -->
            <Button
                x:Name="QueueButtonHost"
                Visibility="Collapsed"
                IsEnabled="False" />
        </Grid>
    </Page>
